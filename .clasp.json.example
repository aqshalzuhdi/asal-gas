{
    "scriptId": "PASTE_YOUR_GAS_SCRIPT_ID_HERE",
    "rootDir": "./src",
    "scriptExtensions": [
        ".js",
        ".gs"
    ],
    "htmlExtensions": [
        ".html"
    ],
    "jsonExtensions": [
        ".json"
    ],
    "filePushOrder": [
        "src/config/Config.js",
        "src/core/Database.js",
        "src/core/Helpers.js",
        "src/core/Validator.js",
        "src/core/Response.js",
        "src/core/View.js",
        "src/core/CompiledViews.js",
        "src/core/Hash.js",
        "src/core/Csrf.js",
        "src/core/SheetStore.js",
        "src/core/Router.js",
        "src/core/Migration.js",
        "src/core/Seeder.js",
        "src/core/Model.js",
        "src/core/Controller.js",
        "src/middleware/Authenticate.js",
        "src/core/Workspace.js"
    ],
    "skipSubdirectories": false
}
