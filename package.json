{
    "name": "asal-gas",
    "version": "2.4.0",
    "bin": {
        "gas": "./gas"
    },
    "scripts": {
        "dev": "nodemon --watch src --watch local --watch .env --ignore local/storage --ext js,json,env local/server.js",
        "migrate": "node gas migrate",
        "migrate:fresh": "node gas migrate:fresh",
        "migrate:fresh:seed": "node gas migrate:fresh --seed",
        "migrate:rollback": "node gas migrate:rollback",
        "migrate:status": "node gas migrate:status",
        "db:seed": "node gas db:seed",
        "route:list": "node gas route:list",
        "push": "node gas push",
        "deploy": "node gas deploy",
        "status": "node gas status"
    },
    "devDependencies": {
        "@google/clasp": "^3.4.1",
        "nodemon": "^3.1.14"
    }
}
