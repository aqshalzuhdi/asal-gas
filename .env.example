APP_NAME="Asal-GAS"
APP_ENV=production
APP_MODE=api
APP_DEBUG=false
APP_KEY=
SHEET_ID=
BASE_URL=
API_PREFIX=api

# Optional explicit deploy sync policy:
# GAS_DEPLOY_ENV_SYNC: ask | keep | merge | overwrite
# GAS_DEPLOY_SHEET_MODE: ask | keep | env | generate
# GAS_DEPLOY_AUTO_KEY: true | false
GAS_DEPLOY_ENV_SYNC=ask
GAS_DEPLOY_SHEET_MODE=ask
GAS_DEPLOY_AUTO_KEY=true
