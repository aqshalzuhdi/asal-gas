            }
            if (cfg.appKey !== remoteAppKey) {
                cfg.appKey = remoteAppKey;
                writeClaspConfig(cfg);
            }
        }
    } else if (localAppKey) {
        resolvedAppKey = localAppKey;
        forceAppKey = true;
        console.log("🔑 Queued local APP_KEY for Script Properties.");
    } else if (autoGenerateKey || isFresh) {
        resolvedAppKey = generateAppKey();
        forceAppKey = true;
        upsertEnvKey(envPath, "APP_KEY", resolvedAppKey);
        cfg.appKey = resolvedAppKey;
        writeClaspConfig(cfg);
        console.log(`🔑 Auto-generated APP_KEY (${maskSecret(resolvedAppKey)}) and saved to .env.`);
    } else if (!nonInteractive) {
        console.log("\n🔐 APP_KEY is not defined in Script Properties or .env.");
        const ans = await askQuestion("Generate a new APP_KEY now? [Y/n]: ");
        if (!["n", "no"].includes(ans.toLowerCase())) {
            resolvedAppKey = generateAppKey();
            forceAppKey = true;
            upsertEnvKey(envPath, "APP_KEY", resolvedAppKey);
            cfg.appKey = resolvedAppKey;
            writeClaspConfig(cfg);
            console.log(`🔑 Generated APP_KEY (${maskSecret(resolvedAppKey)}) and saved to .env.`);
        }
    }

    if (resolvedAppKey) {
        appEnv.APP_KEY = resolvedAppKey;
    }

    const remoteSheetId = String(remoteProps.SHEET_ID || "").trim();
    const localSheetId = String(appEnv.SHEET_ID || readEnvKey(envPath, "SHEET_ID") || "").trim();
    let sheetMode = "keep";
    let customSheetId = "";

    if (remoteSheetId) {
        if (sheetPolicy === "ask" && !nonInteractive) {
            console.log(`\n📄 SHEET_ID is already defined in Script Properties: ${remoteSheetId}`);
            if (localSheetId && localSheetId !== remoteSheetId) {
                console.log(`   (Local .env SHEET_ID is different: ${localSheetId})`);
            }
            console.log("   [1] Keep current Script Properties SHEET_ID (default)");
            console.log("   [2] Change SHEET_ID (enter new ID or use .env value)");
            console.log("   [3] Generate a brand new Google Spreadsheet");
            const choice = await askQuestion("Select SHEET_ID option [1/2/3] (default: 1): ");

            if (choice === "2") {
                const hint = localSheetId ? ` [${localSheetId}]` : "";
                const entered = await askQuestion(`Enter new SHEET_ID${hint}: `);
                const chosenId = entered || localSheetId;
                if (chosenId) {
                    sheetMode = "custom";
                    customSheetId = chosenId;
                    upsertEnvKey(envPath, "SHEET_ID", chosenId);
                    console.log(`📄 Will update SHEET_ID to: ${chosenId}`);
                } else {
                    console.log("⚠️  Empty SHEET_ID entered. Keeping existing Script Properties SHEET_ID.");
                    sheetMode = "keep";
                }
            } else if (choice === "3") {
                sheetMode = "generate";
                console.log("📄 Will generate a brand new Google Spreadsheet.");
            } else {
                sheetMode = "keep";
                console.log("🛡️  Keeping existing Script Properties SHEET_ID.");
            }
        } else if (sheetPolicy === "env") {
            if (localSheetId) {
                sheetMode = "env";
                console.log(`📄 Updating SHEET_ID from .env: ${localSheetId}`);
            } else {
                sheetMode = "keep";
                console.log("⚠️  GAS_DEPLOY_SHEET_MODE=env requested, but .env SHEET_ID is empty. Keeping existing SHEET_ID.");
            }
        } else if (sheetPolicy === "generate") {
            sheetMode = "generate";
            console.log("📄 Generating a brand new Google Spreadsheet (explicit policy).");
        } else {
            sheetMode = "keep";
            console.log(`🛡️  Keeping existing Script Properties SHEET_ID (${remoteSheetId}).`);
        }
    } else if (localSheetId && sheetPolicy !== "generate") {
        sheetMode = "env";
        console.log(`📄 Using SHEET_ID from .env: ${localSheetId}`);
    } else if (sheetPolicy === "ask" && !nonInteractive && !isFresh) {
        console.log("\n📄 SHEET_ID is not defined yet in Script Properties or .env.");
        console.log("   [1] Auto-generate a new Google Spreadsheet (default)");
        console.log("   [2] Enter an existing Google Spreadsheet ID");
        const choice = await askQuestion("Select SHEET_ID option [1/2] (default: 1): ");
        if (choice === "2") {
            const entered = await askQuestion("Enter existing SHEET_ID: ");
            if (entered) {
                sheetMode = "custom";
                customSheetId = entered;
                upsertEnvKey(envPath, "SHEET_ID", entered);
            } else {
                sheetMode = "generate";
            }
        } else {
            sheetMode = "generate";
        }
    } else {
        sheetMode = "generate";
    }

    let envMode = "merge";
    if (!remoteExists) {
        envMode = "overwrite";
    } else if (envSyncPolicy === "ask") {
        const diff = computeEnvDiff(appEnv, remoteProps);
        if (diff.added.length === 0 && diff.changed.length === 0) {
            envMode = "keep";
            console.log("✅ Script Properties are already in sync with .env.");
        } else if (!nonInteractive) {
            console.log("\n⚙️  Script Properties already exist on GAS:");
            if (diff.added.length > 0) {
                console.log(`   + New keys in .env      : ${diff.added.join(", ")}`);
            }
            if (diff.changed.length > 0) {
                console.log(`   ~ Modified keys in .env : ${diff.changed.join(", ")}`);
            }
            console.log("   [1] keep      - Keep existing Script Properties, only add missing keys (default)");
            console.log("   [2] merge     - Update modified keys from .env (respects SHEET_ID & APP_KEY rules)");
            console.log("   [3] overwrite - Overwrite all keys from .env");
            const modeChoice = await askQuestion("Update Script Properties? [1/2/3] (default: 1): ");
            if (modeChoice === "2" || modeChoice.toLowerCase() === "merge") {
                envMode = "merge";
            } else if (modeChoice === "3" || modeChoice.toLowerCase() === "overwrite") {
                envMode = "overwrite";
            } else {
                envMode = "keep";
            }
        } else {
            envMode = "keep";
            console.log("🛡️  Non-interactive mode: keeping existing Script Properties (set GAS_DEPLOY_ENV_SYNC=merge to update).");
        }
    } else {
        envMode = envSyncPolicy;
        console.log(`⚙️  Applying explicit Script Properties sync mode: ${envMode}`);
    }

    return {
        appEnv,
        envMode,
        sheetMode,
        customSheetId,
        appKey: resolvedAppKey,
        forceAppKey,
        autoGenerateKey,
        fresh: isFresh
    };
}

