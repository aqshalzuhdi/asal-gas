function hasRequiredScopes(scopeStr) {
    const s = String(scopeStr || "");
    return (
        s.includes("https://www.googleapis.com/auth/spreadsheets") &&
        s.includes("https://www.googleapis.com/auth/drive")
    );
}

function isClaspCredsLoggedIn(clientId) {
    if (!clientId) return false;

    for (const filePath of getClaspRcTargets()) {
        try {
            if (!fs.existsSync(filePath)) continue;
            const raw = fs.readFileSync(filePath, "utf8");
            if (!raw.includes(clientId)) continue;

            const rc = JSON.parse(raw);
            if (rc.tokens && typeof rc.tokens === "object") {
                for (const key of Object.keys(rc.tokens)) {
                    const entry = rc.tokens[key] || {};
                    const scope = entry.scope || entry.token?.scope || "";
                    const token = entry.access_token || entry.token?.access_token;
                    if (token && hasRequiredScopes(scope)) {
                        return true;
                    }
                }
            }

            const rootScope = rc.scope || rc.token?.scope || "";
            const rootToken = rc.access_token || rc.token?.access_token;
            if (rootToken && hasRequiredScopes(rootScope)) {
                return true;
            }
        } catch (_) { }
    }

    return false;
}

async function authorizeScopesFallback(creds, rcPath) {
    const installed = creds.installed || {};
    const manifestPath = path.join(SRC_DIR, "appsscript.json");
    let manifestScopes = [
        "https://www.googleapis.com/auth/spreadsheets",
        "https://www.googleapis.com/auth/drive",
        "https://www.googleapis.com/auth/script.external_request"
    ];

    try {
        if (fs.existsSync(manifestPath)) {
            const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
            if (Array.isArray(manifest.oauthScopes) && manifest.oauthScopes.length > 0) {
                manifestScopes = manifest.oauthScopes;
            }
        }
    } catch (_) { }

    const allScopes = Array.from(new Set([
        ...manifestScopes,
        "https://www.googleapis.com/auth/script.projects",
        "https://www.googleapis.com/auth/script.deployments",
        "https://www.googleapis.com/auth/userinfo.email"
    ]));

    return new Promise((resolve) => {
        const server = http.createServer((req, res) => {
            const port = server.address().port;
            const redirectUri = `http://localhost:${port}`;
            const reqUrl = new URL(req.url, redirectUri);
            const code = reqUrl.searchParams.get("code");
            const error = reqUrl.searchParams.get("error");

            res.setHeader("Connection", "close");
            if (error || !code) {
                res.writeHead(400, { "Content-Type": "text/plain" });
                res.end("Authorization failed. You can close this tab.");
                server.close();
                resolve(false);
                return;
            }

            res.writeHead(200, { "Content-Type": "text/plain" });
            res.end("Authorization successful! You can close this tab and return to the terminal.");
            server.close();

            const postData = new URLSearchParams({
                code,
                client_id: installed.client_id,
                client_secret: installed.client_secret,
                redirect_uri: redirectUri,
                grant_type: "authorization_code"
            }).toString();

            const tokenReq = https.request("https://oauth2.googleapis.com/token", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded",
                    "Content-Length": Buffer.byteLength(postData)
                }
            }, (tokenRes) => {
                let body = "";
                tokenRes.on("data", (chunk) => { body += chunk; });
                tokenRes.on("end", () => {
                    try {
                        const tokenJson = JSON.parse(body);
                        if (!tokenJson.access_token) {
                            resolve(false);
                            return;
                        }

                        const newToken = {
                            access_token: tokenJson.access_token,
                            refresh_token: tokenJson.refresh_token,
                            scope: tokenJson.scope || allScopes.join(" "),
                            token_type: tokenJson.token_type || "Bearer",
                            expiry_date: Date.now() + ((tokenJson.expires_in || 3599) * 1000)
                        };

                        const rcData = fs.existsSync(rcPath)
                            ? JSON.parse(fs.readFileSync(rcPath, "utf8"))
                            : {};

                        if (rcData.tokens && typeof rcData.tokens === "object") {
                            const keys = Object.keys(rcData.tokens);
                            const targetKeys = keys.length > 0 ? keys : ["default"];
                            for (const key of targetKeys) {
                                const prev = rcData.tokens[key] || {};
                                rcData.tokens[key] = {
                                    ...prev,
                                    type: prev.type || "authorized_user",
                                    client_id: installed.client_id,
                                    client_secret: installed.client_secret,
                                    clientId: installed.client_id,
                                    clientSecret: installed.client_secret,
                                    access_token: newToken.access_token,
                                    refresh_token: newToken.refresh_token || prev.refresh_token,
                                    scope: newToken.scope,
                                    token_type: newToken.token_type,
                                    expiry_date: newToken.expiry_date
                                };
                                if (prev.token) {
                                    rcData.tokens[key].token = newToken;
                                }
                            }
                        } else {
                            rcData.token = newToken;
                            rcData.access_token = newToken.access_token;
                            rcData.refresh_token = newToken.refresh_token;
                            rcData.scope = newToken.scope;
                            rcData.oauth2ClientSettings = {
                                clientId: installed.client_id,
                                clientSecret: installed.client_secret,
                                redirectUri: "http://localhost"
                            };
                            rcData.isLocalCreds = true;
                        }

                        fs.writeFileSync(rcPath, JSON.stringify(rcData, null, 2) + "\n", "utf8");
                        resolve(true);
                    } catch (_) {
                        resolve(false);
                    }
                });
            });

            tokenReq.on("error", () => resolve(false));
            tokenReq.write(postData);
            tokenReq.end();
        });

        server.listen(0, "127.0.0.1", () => {
            const port = server.address().port;
            const authUrl = new URL("https://accounts.google.com/o/oauth2/v2/auth");
            authUrl.searchParams.set("client_id", installed.client_id);
            authUrl.searchParams.set("redirect_uri", `http://localhost:${port}`);
            authUrl.searchParams.set("response_type", "code");
            authUrl.searchParams.set("scope", allScopes.join(" "));
            authUrl.searchParams.set("access_type", "offline");
            authUrl.searchParams.set("prompt", "consent");

            console.log(`🌐 Opening browser to grant Sheets & Drive scopes:\n${authUrl.toString()}`);
            openExternalUrl(authUrl.toString());
        });
    });
}

function ensureManifestScopes() {
    const manifestPath = path.join(SRC_DIR, "appsscript.json");
    if (!fs.existsSync(manifestPath)) return false;

    try {
        const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
        const requiredScopes = [
            "https://www.googleapis.com/auth/spreadsheets",
            "https://www.googleapis.com/auth/drive",
            "https://www.googleapis.com/auth/script.external_request"
        ];

        const currentScopes = Array.isArray(manifest.oauthScopes) ? manifest.oauthScopes : [];
        const mergedScopes = Array.from(new Set([...currentScopes, ...requiredScopes]));
        const hasExecutionApi = manifest.executionApi && manifest.executionApi.access === "MYSELF";

        if (mergedScopes.length !== currentScopes.length || !hasExecutionApi) {
            manifest.executionApi = { access: "MYSELF" };
            manifest.oauthScopes = mergedScopes;
            fs.writeFileSync(manifestPath, JSON.stringify(manifest, null, 2) + "\n", "utf8");
            return true;
        }
    } catch (_) { }

    return false;
}

