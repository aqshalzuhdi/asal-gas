function createMigration(rawName) {
    const pascalName = toPascalCase(rawName);
    const snakeName = toSnakeCase(pascalName);
    const ts = timestamp();
    const migrationId = `${ts}_${snakeName}`;
    const filename = `Migration_${ts}_${pascalName}.js`;

    const createMatch = snakeName.match(/^create_(.+)_table$/);
    const addColMatch = snakeName.match(/^add_(.+)_to_(.+)_table$/);
    const dropColMatch = snakeName.match(/^(?:drop|remove)_(.+)_from_(.+)_table$/);

    let body;
    if (createMatch) {
        const tableName = createMatch[1];
        body = `Migration.register({
    name: "${migrationId}",

    up: function () {
        Schema.create("${tableName}", function (table) {
            table.id();
            table.string("name");
            table.timestamps();
            table.softDeletes();
        });
    },

    down: function () {
        Schema.dropIfExists("${tableName}");
    }
});
`;
    } else if (addColMatch) {
        const [, colName, targetTable] = addColMatch;
        body = `Migration.register({
    name: "${migrationId}",

    up: function () {
        Schema.table("${targetTable}", function (table) {
            table.string("${colName}");
        });
    },

    down: function () {
        Schema.table("${targetTable}", function (table) {
            table.dropColumn("${colName}");
        });
    }
});
`;
    } else if (dropColMatch) {
        const [, droppedCol, fromTable] = dropColMatch;
        body = `Migration.register({
    name: "${migrationId}",

    up: function () {
        Schema.table("${fromTable}", function (table) {
            table.dropColumn("${droppedCol}");
        });
    },

    down: function () {
        Schema.table("${fromTable}", function (table) {
            table.string("${droppedCol}");
        });
    }
});
`;
    } else {
        body = `Migration.register({
    name: "${migrationId}",

    up: function () {
        Schema.table("table_name", function (table) {
            // table.string("new_column").after("id");
        });
    },

    down: function () {
        Schema.table("table_name", function (table) {
            // table.dropColumn("new_column");
        });
    }
});
`;
    }

    writeSrcFile(`database/migrations/${filename}`, body);
}

function createController(rawName, modeFlag) {
    const className = toPascalCase(rawName).endsWith("Controller")
        ? toPascalCase(rawName)
        : `${toPascalCase(rawName)}Controller`;

    const baseName = className.replace(/Controller$/, "");
    const snakeBase = toSnakeCase(baseName);
    const sheetName = pluralizeSnake(snakeBase);
    const viewName = snakeBase;
    const mode = String(modeFlag || "--web").toLowerCase();

    let innerBody = "";

    if (mode === "--api" || mode === "--resource" || mode === "-r") {
        innerBody = `                    sheet: "${sheetName}",
                    with: [],

                    // Lifecycle hooks: beforeStore, afterStore, beforeUpdate, afterUpdate, beforeDestroy, afterDestroy
                    // beforeStore: function (ctx) {
                    //     return { status: true };
                    // },

                    // Override resource methods: index, store, update, destroy, restore, forceDelete
                    // index: function (ctx) {
                    //     return this.superIndex(ctx);
                    // }`;
    } else if (mode === "--hybrid") {
        innerBody = `                    sheet: "${sheetName}",
                    with: [],

                    index: function (ctx) {
                        var res = this.superIndex(ctx);
                        if (ctx.wantsJson()) return res;

                        return view("${viewName}.index", {
                            items: res.data || [],
                            meta: res.meta || null
                        });
                    },

                    show: function (ctx) {
                        var id = ctx.routeParams.id || ctx.params.id;
                        var res = read(this.sheet, { id: id }, 1, 1);
                        var item = (res.data && res.data[0]) ? res.data[0] : null;

                        if (!item) {
                            return failResponse("${baseName} not found.", 404);
                        }

                        return this.respond(ctx, "${viewName}.show", { item: item });
                    }`;
    } else {
        innerBody = `                    index: function (ctx) {
                        return view("${viewName}", {
                            title: "${baseName}"
                        });
                    }

                    // Example: otomatis merender view di Web dan JSON di API
                    // show: function (ctx) {
                    //     return this.respond(ctx, "${viewName}.show", { id: ctx.routeParams.id });
                    // }`;
    }

    const content = `var ${className} = (function () {
    var _instance;
    return new Proxy({}, {
        get: function (_, prop) {
            if (!_instance) {
                _instance = BaseController.init({
${innerBody}
                });
            }
            var val = _instance[prop];
            return typeof val === "function" ? val.bind(_instance) : val;
        }
    });
})();
`;

    writeSrcFile(`app/Controllers/${className}.js`, content);
}

function createSeeder(rawName) {
