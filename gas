function runClaspArgs(args, options = {}) {
    const res = spawnBinSync("npx", ["clasp", ...args], {
        stdio: "inherit",
        ...options
    });
    if (res.status !== 0) {
        process.exit(res.status || 1);
    }
    return res;
}

function ensureClaspConfigured() {
    if (!fs.existsSync(CLASP_FILE)) {
        console.error('❌ .clasp.json not found. Run "gas init" or "gas init --id <SCRIPT_ID>" first.');
        process.exit(1);
    }
}

function readClaspConfig() {
    ensureClaspConfigured();
    return JSON.parse(fs.readFileSync(CLASP_FILE, "utf8"));
}

function writeClaspConfig(cfg) {
    fs.writeFileSync(CLASP_FILE, JSON.stringify(cfg, null, 4) + "\n", "utf8");
}

function initGasProject(titleInput) {
    const isForce = flags.includes("-f") || flags.includes("--force");
    const existingScriptId = getFlagValue("--id");

    if (fs.existsSync(CLASP_FILE) && !isForce) {
        console.error("⚠️  .clasp.json already exists. Use --force to overwrite the existing GAS configuration.");
        process.exit(1);
    }

    if (existingScriptId) {
        const claspConfig = {
            scriptId: existingScriptId.trim(),
            rootDir: "./src",
            scriptExtensions: [".js", ".gs"],
            htmlExtensions: [".html"],
            jsonExtensions: [".json"],
            filePushOrder: DEFAULT_FILE_PUSH_ORDER,
            skipSubdirectories: false
        };
        writeClaspConfig(claspConfig);
        console.log(`✅ Linked .clasp.json to Script ID: ${claspConfig.scriptId}`);
        return;
    }

    const projectTitle = (titleInput || "Asal-GAS Backend").trim();
    const manifestPath = path.join(SRC_DIR, "appsscript.json");
    const manifestBackup = fs.existsSync(manifestPath) ? fs.readFileSync(manifestPath, "utf8") : null;

    console.log(`🚀 Creating Google Apps Script project "${projectTitle}"...`);
    runClaspArgs(["create", "--type", "standalone", "--title", projectTitle, "--rootDir", "./src"]);

    const nestedClaspFile = path.join(SRC_DIR, ".clasp.json");
    if (!fs.existsSync(CLASP_FILE) && fs.existsSync(nestedClaspFile)) {
        fs.renameSync(nestedClaspFile, CLASP_FILE);
    }

    if (fs.existsSync(CLASP_FILE)) {
        const currentCfg = JSON.parse(fs.readFileSync(CLASP_FILE, "utf8"));
        currentCfg.rootDir = "./src";
        currentCfg.scriptExtensions = [".js", ".gs"];
        currentCfg.htmlExtensions = [".html"];
        currentCfg.jsonExtensions = [".json"];
        currentCfg.filePushOrder = DEFAULT_FILE_PUSH_ORDER;
        currentCfg.skipSubdirectories = false;
        writeClaspConfig(currentCfg);
    }

    if (manifestBackup !== null) {
        fs.writeFileSync(manifestPath, manifestBackup, "utf8");
    }

    console.log("✅ GAS project ready! Run 'gas push' or 'gas deploy' to upload source code.");
}

