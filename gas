function compileViews() {
    const viewsRoot = path.join(SRC_DIR, "resources", "views");
    const outFile = path.join(SRC_DIR, "core", "CompiledViews.js");
    const lines = [
        "// AUTO-GENERATED BY `gas push` / `gas view:compile` — DO NOT EDIT MANUALLY",
        "(function () {"
    ];
    let compiledCount = 0;

    if (fs.existsSync(viewsRoot)) {
        function walk(dir) {
            const entries = fs.readdirSync(dir, { withFileTypes: true })
                .sort((a, b) => a.name.localeCompare(b.name));

            for (const entry of entries) {
                const fullPath = path.join(dir, entry.name);
                if (entry.isDirectory()) {
                    walk(fullPath);
                } else if (entry.isFile() && /\.gas\.js$/i.test(entry.name)) {
                    const rel = path.relative(viewsRoot, fullPath).replace(/\\/g, "/");
                    const viewName = rel.replace(/\.gas\.js$/i, "").replace(/\//g, ".");
                    const html = fs.readFileSync(fullPath, "utf8");
                    lines.push(`    View.register(${JSON.stringify(viewName)}, ${JSON.stringify(html)});`);
                    compiledCount++;
                }
            }
        }
        walk(viewsRoot);
    }

    lines.push("})();");
    lines.push("");
    fs.writeFileSync(outFile, lines.join("\n"), "utf8");
    console.log(`✅ Compiled ${compiledCount} view(s) -> src/core/CompiledViews.js`);
}

function listRoutes() {
    bootGasRuntime();

    if (!global.Route || typeof global.Route.list !== "function") {
        console.error("❌ Route.list() is not available. Add Route.list() to src/core/Router.js first.");
        process.exit(1);
    }

    const filterQuery = (arg1 || "").trim().toLowerCase();
    const methodFilter = (getFlagValue("--method") || "").trim().toUpperCase();

    let routes = global.Route.list();

    if (methodFilter) {
        routes = routes.filter((item) =>
            item.methods.toUpperCase().split("|").includes(methodFilter)
        );
    }

    if (filterQuery) {
        routes = routes.filter((item) =>
            item.route.toLowerCase().includes(filterQuery) ||
            item.handler.toLowerCase().includes(filterQuery) ||
            item.action.toLowerCase().includes(filterQuery) ||
            item.middleware.toLowerCase().includes(filterQuery)
        );
    }

    if (routes.length === 0) {
        console.log("No matching routes found.");
        return;
    }

    const headers = {
        methods: "METHOD",
        route: "ROUTE",
        action: "ACTION",
        handler: "HANDLER",
        middleware: "MIDDLEWARE",
        sheet: "SHEET"
    };

    const colWidths = {
        methods: Math.max(headers.methods.length, ...routes.map((r) => r.methods.length)),
        route: Math.max(headers.route.length, ...routes.map((r) => r.route.length)),
        action: Math.max(headers.action.length, ...routes.map((r) => r.action.length)),
        handler: Math.max(headers.handler.length, ...routes.map((r) => r.handler.length)),
        middleware: Math.max(headers.middleware.length, ...routes.map((r) => r.middleware.length)),
        sheet: Math.max(headers.sheet.length, ...routes.map((r) => r.sheet.length))
    };

    const pad = (val, width) => String(val).padEnd(width, " ");
    const separator = [
        "-".repeat(colWidths.methods),
        "-".repeat(colWidths.route),
        "-".repeat(colWidths.action),
        "-".repeat(colWidths.handler),
        "-".repeat(colWidths.middleware),
        "-".repeat(colWidths.sheet)
    ].join("-+-");

    const formatRow = (row) => [
        pad(row.methods, colWidths.methods),
        pad(row.route, colWidths.route),
        pad(row.action, colWidths.action),
        pad(row.handler, colWidths.handler),
        pad(row.middleware, colWidths.middleware),
        pad(row.sheet, colWidths.sheet)
    ].join(" | ");

    console.log("");
    console.log(formatRow(headers));
    console.log(separator);
    routes.forEach((row) => console.log(formatRow(row)));
    console.log(`\nTotal routes: ${routes.length}\n`);
}

function listAllFilesInGitTree(ref) {
    const res = spawnSync("git", ["ls-tree", "-r", "--name-only", ref], {
        cwd: ROOT_DIR,
        encoding: "utf8"
    });
    if (res.status !== 0) return [];
    return String(res.stdout || "")
        .split(/\r?\n/)
        .map((s) => s.trim())
        .filter(Boolean);
}

function listLocalFilesRecursive(relDir) {
    const absDir = path.join(ROOT_DIR, relDir);
    if (!fs.existsSync(absDir) || !fs.statSync(absDir).isDirectory()) return [];
    const results = [];

    function walk(dir) {
        const entries = fs.readdirSync(dir, { withFileTypes: true });
        for (const entry of entries) {
            const fullPath = path.join(dir, entry.name);
            if (entry.isDirectory()) {
                walk(fullPath);
            } else if (entry.isFile()) {
                results.push(path.relative(ROOT_DIR, fullPath).replace(/\\/g, "/"));
            }
        }
    }

    walk(absDir);
    return results;
}

function checkoutFilesFromRef(ref, fileList) {
    const chunkSize = 50;
    for (let i = 0; i < fileList.length; i += chunkSize) {
        const batch = fileList.slice(i, i + chunkSize);
        const res = spawnSync("git", ["checkout", ref, "--", ...batch], {
            cwd: ROOT_DIR,
            stdio: "inherit"
        });
        if (res.status !== 0) {
            process.exit(res.status || 1);
        }
    }
    if (process.platform !== "win32" && fileList.includes("gas")) {
        try {
            fs.chmodSync(path.join(ROOT_DIR, "gas"), 0o755);
        } catch (_) { }
    }
}

function readGitTextFile(ref, relPath) {
    const res = spawnSync("git", ["show", `${ref}:${relPath}`], {
        cwd: ROOT_DIR,
        encoding: "utf8"
    });
    if (res.status !== 0) return null;
    return String(res.stdout || "");
}

function readGitJsonFile(ref, relPath) {
    const raw = readGitTextFile(ref, relPath);
    if (!raw) return null;
    try {
        return JSON.parse(raw);
    } catch (_) {
        return null;
    }
}

function gitRefExists(ref) {
    const res = spawnSync("git", ["rev-parse", "--verify", "--quiet", ref], {
        cwd: ROOT_DIR,
        encoding: "utf8"
    });
    return res.status === 0;
}

function gitPathExistsInHead(relPath) {
    const res = spawnSync("git", ["cat-file", "-e", `HEAD:${relPath}`], {
        cwd: ROOT_DIR,
        stdio: "ignore"
    });
    return res.status === 0;
}

function gitIsIgnored(relPath) {
    const res = spawnSync("git", ["check-ignore", "-q", relPath], {
        cwd: ROOT_DIR,
        stdio: "ignore"
    });
    return res.status === 0;
}

function resolveRemoteSourceRef(remoteName, branchOrTag, repoUrl, skipFetch = false) {
    const remotesRaw = execSync("git remote", { cwd: ROOT_DIR, encoding: "utf8" });
    const remotes = remotesRaw.split(/\r?\n/).map((s) => s.trim()).filter(Boolean);

    if (!remotes.includes(remoteName)) {
        console.log(`➕ Adding remote '${remoteName}' -> ${repoUrl}`);
        const addRes = spawnSync("git", ["remote", "add", remoteName, repoUrl], {
            cwd: ROOT_DIR,
            stdio: "inherit"
        });
        if (addRes.status !== 0) process.exit(addRes.status || 1);
    } else if (getFlagValue("--repo")) {
        const setRes = spawnSync("git", ["remote", "set-url", remoteName, repoUrl], {
            cwd: ROOT_DIR,
            stdio: "inherit"
        });
        if (setRes.status !== 0) process.exit(setRes.status || 1);
    }

    const remoteBranchRef = `refs/remotes/${remoteName}/${branchOrTag}`;
    const localTagRef = `refs/tags/${branchOrTag}`;

    if (!skipFetch) {
        console.log(`🔄 Fetching '${branchOrTag}' from ${remoteName}...`);
        const branchFetch = spawnSync(
            "git",
            ["fetch", "--tags", remoteName, `+refs/heads/${branchOrTag}:${remoteBranchRef}`],
            { cwd: ROOT_DIR, stdio: "pipe", encoding: "utf8" }
        );

        if (branchFetch.status === 0) {
            return `${remoteName}/${branchOrTag}`;
        }

        const tagFetch = spawnSync(
            "git",
            ["fetch", remoteName, `+refs/tags/${branchOrTag}:${localTagRef}`],
            { cwd: ROOT_DIR, stdio: "pipe", encoding: "utf8" }
        );

        if (tagFetch.status === 0) {
            return localTagRef;
        }

        console.error(`❌ Branch or tag '${branchOrTag}' not found on remote '${remoteName}' (${repoUrl}).`);
        process.exit(1);
    }

    if (gitRefExists(remoteBranchRef)) return `${remoteName}/${branchOrTag}`;
    if (gitRefExists(localTagRef)) return localTagRef;
    return `${remoteName}/${branchOrTag}`;
}

function restorePathsToHead(paths) {
    const uniquePaths = Array.from(new Set(paths)).filter(Boolean);
    if (uniquePaths.length === 0) return;

    const existingInHead = [];
    const newFromUpstream = [];

    for (const relPath of uniquePaths) {
        if (gitPathExistsInHead(relPath)) {
            existingInHead.push(relPath);
        } else {
            newFromUpstream.push(relPath);
        }
    }

    const chunkSize = 50;
    for (let i = 0; i < existingInHead.length; i += chunkSize) {
        const batch = existingInHead.slice(i, i + chunkSize);
        spawnSync("git", ["checkout", "HEAD", "--", ...batch], {
            cwd: ROOT_DIR,
            stdio: "ignore"
        });
    }

    for (let i = 0; i < newFromUpstream.length; i += chunkSize) {
        const batch = newFromUpstream.slice(i, i + chunkSize);
        spawnSync("git", ["rm", "-f", "--ignore-unmatch", ...batch], {
            cwd: ROOT_DIR,
            stdio: "ignore"
        });
    }
}

function mergeIgnoreFileFromRef(ref, relPath) {
    const remoteContent = readGitTextFile(ref, relPath);
    if (remoteContent === null) return;

    const targetPath = path.join(ROOT_DIR, relPath);
    if (!fs.existsSync(targetPath)) {
        fs.writeFileSync(targetPath, remoteContent, "utf8");
        console.log(`➕ Created ${relPath} from ${ref}.`);
        return;
    }

    const localContent = fs.readFileSync(targetPath, "utf8");
    const existingRules = new Set(
        localContent
            .split(/\r?\n/)
            .map((line) => line.trim())
            .filter((line) => line && !line.startsWith("#"))
    );

    const newRules = remoteContent
        .split(/\r?\n/)
        .map((line) => line.trim())
        .filter((line) => line && !line.startsWith("#") && !existingRules.has(line));

    if (newRules.length === 0) return;

    const normalizedLocal = localContent.replace(/\s*$/, "");
    const updatedContent = `${normalizedLocal}\n${newRules.join("\n")}\n`;
    fs.writeFileSync(targetPath, updatedContent, "utf8");
    console.log(`🔄 Merged ${newRules.length} new rule(s) into ${relPath}: ${newRules.join(", ")}`);
}

function preserveCodeGeneratorTarget(previousSource) {
    if (!previousSource) return;
    const targetPath = path.join(SRC_DIR, "tools", "CodeGenerator.js");
    if (!fs.existsSync(targetPath)) return;

    const prevMatch = previousSource.match(/var\s+GENERATOR_TARGET\s*=\s*\{[\s\S]*?\n\};/);
    if (!prevMatch) return;

    const currentSource = fs.readFileSync(targetPath, "utf8");
    if (!/var\s+GENERATOR_TARGET\s*=\s*\{[\s\S]*?\n\};/.test(currentSource)) return;

    const updatedSource = currentSource.replace(/var\s+GENERATOR_TARGET\s*=\s*\{[\s\S]*?\n\};/, prevMatch[0]);
    if (updatedSource !== currentSource) {
        fs.writeFileSync(targetPath, updatedSource, "utf8");
    }
}

function syncClaspConfigAfterUpdate() {
    if (!fs.existsSync(CLASP_FILE)) return;
    try {
        const cfg = JSON.parse(fs.readFileSync(CLASP_FILE, "utf8"));
        let changed = false;

        const existingOrder = Array.isArray(cfg.filePushOrder) ? cfg.filePushOrder : [];
        const filteredExisting = existingOrder.filter((item) => !LEGACY_CORE_FILES.has(item));
        const mergedOrder = Array.from(new Set([...DEFAULT_FILE_PUSH_ORDER, ...filteredExisting]));
        if (JSON.stringify(existingOrder) !== JSON.stringify(mergedOrder)) {
            cfg.filePushOrder = mergedOrder;
            changed = true;
        }

        const defaults = {
            rootDir: "./src",
            scriptExtensions: [".js", ".gs"],
            htmlExtensions: [".html"],
            jsonExtensions: [".json"],
            skipSubdirectories: false
        };

        for (const [key, defaultVal] of Object.entries(defaults)) {
            if (cfg[key] === undefined) {
                cfg[key] = defaultVal;
                changed = true;
            }
        }

        if (changed) {
            writeClaspConfig(cfg);
            console.log("🔄 Merged configuration & 'filePushOrder' in .clasp.json.");
        }
    } catch (err) {
        console.warn(`⚠️  Could not merge .clasp.json: ${err.message}`);
    }
}

function syncPackageJsonFromRef(ref) {
    const remotePkg = readGitJsonFile(ref, "package.json");
    const localPkgPath = path.join(ROOT_DIR, "package.json");

    if (!remotePkg || !fs.existsSync(localPkgPath)) {
        return { remotePkg, needsNpmInstall: false };
    }

    let needsNpmInstall = false;

    try {
        const localPkg = JSON.parse(fs.readFileSync(localPkgPath, "utf8"));
        const headPkg = readGitJsonFile("HEAD", "package.json") || {};
        const changes = [];
        const depChanges = [];

        if (remotePkg.version && localPkg.version !== remotePkg.version) {
            const prevVersion = localPkg.version || "(none)";
            localPkg.version = remotePkg.version;
            changes.push(`version: ${prevVersion} -> ${remotePkg.version}`);

            const localLockPath = path.join(ROOT_DIR, "package-lock.json");
            if (fs.existsSync(localLockPath)) {
                try {
                    const localLock = JSON.parse(fs.readFileSync(localLockPath, "utf8"));
                    let lockChanged = false;

                    if (localLock.version !== remotePkg.version) {
                        localLock.version = remotePkg.version;
                        lockChanged = true;
                    }
                    if (localLock.packages && localLock.packages[""] && localLock.packages[""].version !== remotePkg.version) {
                        localLock.packages[""].version = remotePkg.version;
                        lockChanged = true;
                    }

                    if (lockChanged) {
                        fs.writeFileSync(localLockPath, JSON.stringify(localLock, null, 2) + "\n", "utf8");
                        changes.push(`package-lock.json version -> ${remotePkg.version}`);
                    }
                } catch (_) { }
            }
        }

        if (remotePkg.scripts && typeof remotePkg.scripts === "object") {
            if (!localPkg.scripts || typeof localPkg.scripts !== "object") {
                localPkg.scripts = {};
            }
            const headScripts = (headPkg.scripts && typeof headPkg.scripts === "object") ? headPkg.scripts : {};

            for (const [key, remoteVal] of Object.entries(remotePkg.scripts)) {
                const localVal = localPkg.scripts[key];
                const headVal = headScripts[key];

                if (localVal === undefined) {
                    localPkg.scripts[key] = remoteVal;
                    changes.push(`scripts.${key} (added)`);
                } else if (localVal !== remoteVal && (headVal === undefined || localVal === headVal)) {
                    localPkg.scripts[key] = remoteVal;
                    changes.push(`scripts.${key} (updated)`);
                } else if (
                    key === "postinstall" &&
                    typeof localVal === "string" &&
                    typeof remoteVal === "string" &&
                    !localVal.includes(remoteVal)
                ) {
                    localPkg.scripts[key] = `${localVal} && ${remoteVal}`;
                    changes.push(`scripts.${key} (appended)`);
                }
            }
        }

        if (remotePkg.bin && typeof remotePkg.bin === "object") {
            if (!localPkg.bin || typeof localPkg.bin !== "object") {
                localPkg.bin = {};
            }
            const headBin = (headPkg.bin && typeof headPkg.bin === "object") ? headBin : {};

            for (const [key, remoteVal] of Object.entries(remotePkg.bin)) {
                const localVal = localPkg.bin[key];
                const headVal = headBin[key];

                if (localVal === undefined) {
                    localPkg.bin[key] = remoteVal;
                    changes.push(`bin.${key} (added)`);
                } else if (localVal !== remoteVal && (headVal === undefined || localVal === headVal)) {
                    localPkg.bin[key] = remoteVal;
                    changes.push(`bin.${key} (updated)`);
                }
            }
        }

        for (const section of ["dependencies", "devDependencies"]) {
            const remoteDeps = (remotePkg[section] && typeof remotePkg[section] === "object")
                ? remotePkg[section]
                : null;
            if (!remoteDeps) continue;

            if (!localPkg[section] || typeof localPkg[section] !== "object") {
                localPkg[section] = {};
            }
            const headDeps = (headPkg[section] && typeof headPkg[section] === "object")
                ? headPkg[section]
                : {};

            for (const [pkgName, remoteVer] of Object.entries(remoteDeps)) {
                const localVer = localPkg[section][pkgName];
                const headVer = headDeps[pkgName];
                const changedInFramework = remoteVer !== headVer;

                if (!changedInFramework) continue;

                if (localVer === undefined) {
                    localPkg[section][pkgName] = remoteVer;
                    depChanges.push(`${pkgName}: (none) -> ${remoteVer}`);
                    needsNpmInstall = true;
                } else if (localVer !== remoteVer && (headVer === undefined || localVer === headVer)) {
                    localPkg[section][pkgName] = remoteVer;
                    depChanges.push(`${pkgName}: ${localVer} -> ${remoteVer}`);
                    needsNpmInstall = true;
                }
            }
        }

        if (changes.length > 0 || depChanges.length > 0) {
            fs.writeFileSync(localPkgPath, JSON.stringify(localPkg, null, 2) + "\n", "utf8");
        }

        if (changes.length > 0) {
            console.log(`🔄 Merged package.json: ${changes.join(", ")}`);
        }

        if (depChanges.length > 0) {
            console.log("📦 Framework dependency updates applied (user packages preserved):");
            depChanges.forEach((item) => console.log(`   - ${item}`));
        }
    } catch (err) {
        console.warn(`⚠️  Could not smart-merge package.json: ${err.message}`);
    }

    return { remotePkg, needsNpmInstall };
}

function getMergeBaseRef(sourceRef) {
    const res = spawnSync("git", ["merge-base", "HEAD", sourceRef], {
        cwd: ROOT_DIR,
        encoding: "utf8"
    });
    if (res.status !== 0) return null;
    return String(res.stdout || "").trim() || null;
}

function isPlainObject(val) {
    return val !== null && typeof val === "object" && !Array.isArray(val);
}

function deepEqualJson(a, b) {
    if (a === b) return true;
    if (Array.isArray(a) && Array.isArray(b)) {
        if (a.length !== b.length) return false;
        return a.every((item, idx) => deepEqualJson(item, b[idx]));
    }
    if (isPlainObject(a) && isPlainObject(b)) {
        const keysA = Object.keys(a);
        const keysB = Object.keys(b);
        if (keysA.length !== keysB.length) return false;
        return keysA.every((k) => Object.prototype.hasOwnProperty.call(b, k) && deepEqualJson(a[k], b[k]));
    }
    return false;
}

function mergeStringArrayThreeWay(baseArr, localArr, upstreamArr, hasCommonBase) {
    const base = Array.isArray(baseArr) ? baseArr : [];
    const local = Array.isArray(localArr) ? localArr : [];
    const upstream = Array.isArray(upstreamArr) ? upstreamArr : [];

    const baseSet = new Set(base);
    const localSet = new Set(local);

    if (hasCommonBase) {
        const result = upstream.filter((item) => !(baseSet.has(item) && !localSet.has(item)));
        const resultSet = new Set(result);
        for (const item of local) {
            if (!baseSet.has(item) && !resultSet.has(item)) {
                result.push(item);
                resultSet.add(item);
            }
        }
        return result;
    }

    const removedUncommitted = new Set(base.filter((item) => !localSet.has(item)));
    const merged = [];
    const seen = new Set();

    for (const item of [...upstream, ...local]) {
        if (removedUncommitted.has(item) || seen.has(item)) continue;
        seen.add(item);
        merged.push(item);
    }
    return merged;
}

function mergeObjectArrayByKey(baseArr, localArr, upstreamArr, keyCandidates, hasCommonBase) {
    const base = Array.isArray(baseArr) ? baseArr : [];
    const local = Array.isArray(localArr) ? localArr : [];
    const upstream = Array.isArray(upstreamArr) ? upstreamArr : [];

    const getKey = (obj) => {
        if (!isPlainObject(obj)) return null;
        for (const k of keyCandidates) {
            if (obj[k] !== undefined && obj[k] !== null) return `${k}:${obj[k]}`;
        }
        return null;
    };

    const toMap = (arr) => {
        const map = new Map();
        arr.forEach((item, i) => map.set(getKey(item) || `__idx_${i}`, item));
        return map;
    };

    const baseMap = toMap(base);
    const localMap = toMap(local);
    const upstreamMap = toMap(upstream);

    const allKeys = new Set([...upstreamMap.keys(), ...localMap.keys()]);
    const result = [];

    for (const key of allKeys) {
        const hasBase = baseMap.has(key);
        const hasLocal = localMap.has(key);
        const hasUp = upstreamMap.has(key);

        if (hasCommonBase && hasBase && !hasLocal) continue;
        if (!hasCommonBase && hasBase && !hasLocal && hasUp) continue;

        if (hasLocal && hasUp) {
            result.push(
                threeWayMergeJson(baseMap.get(key), localMap.get(key), upstreamMap.get(key), key, hasCommonBase)
            );
        } else if (hasLocal) {
            result.push(localMap.get(key));
        } else {
            result.push(upstreamMap.get(key));
        }
    }
    return result;
}

function threeWayMergeJson(base, local, upstream, fieldName = "", hasCommonBase = true) {
    if (deepEqualJson(local, upstream)) return local;

    if (Array.isArray(local) || Array.isArray(upstream)) {
        const sample = (Array.isArray(local) && local[0]) || (Array.isArray(upstream) && upstream[0]);
        if (typeof sample === "string" || fieldName === "oauthScopes" || fieldName === "urlFetchWhitelist") {
            return mergeStringArrayThreeWay(base, local, upstream, hasCommonBase);
        }
        if (isPlainObject(sample)) {
            return mergeObjectArrayByKey(
                base,
                local,
                upstream,
                ["libraryId", "serviceId", "userSymbol", "name"],
                hasCommonBase
            );
        }
        return local !== undefined ? local : upstream;
    }

    if (isPlainObject(local) && isPlainObject(upstream)) {
        const baseObj = isPlainObject(base) ? base : {};
        const keys = new Set([...Object.keys(baseObj), ...Object.keys(local), ...Object.keys(upstream)]);
        const merged = {};

        for (const key of keys) {
            const inBase = Object.prototype.hasOwnProperty.call(baseObj, key);
            const inLocal = Object.prototype.hasOwnProperty.call(local, key);
            const inUp = Object.prototype.hasOwnProperty.call(upstream, key);

            if (inLocal && inUp) {
                merged[key] = threeWayMergeJson(baseObj[key], local[key], upstream[key], key, hasCommonBase);
            } else if (inLocal && !inUp) {
                if (hasCommonBase && inBase && deepEqualJson(local[key], baseObj[key])) continue;
                merged[key] = local[key];
            } else if (!inLocal && inUp) {
                if (hasCommonBase && inBase && deepEqualJson(upstream[key], baseObj[key])) continue;
                merged[key] = upstream[key];
            }
        }
        return merged;
    }

    if (hasCommonBase) {
        if (deepEqualJson(local, base)) return upstream;
        if (deepEqualJson(upstream, base)) return local;
        console.log(`ℹ️  [manifest] Conflict on "${fieldName}": keeping local (${JSON.stringify(local)}) over upstream (${JSON.stringify(upstream)}).`);
        return local;
    }

    if (base !== undefined && !deepEqualJson(local, base)) return local;
    return local !== undefined ? local : upstream;
}

function mergeAppsScriptManifestFromRef(sourceRef) {
    const manifestRelPath = "src/appsscript.json";
    const manifestFullPath = path.join(SRC_DIR, "appsscript.json");

    const upstreamManifest = readGitJsonFile(sourceRef, manifestRelPath);
    if (!upstreamManifest) return false;

    if (!fs.existsSync(manifestFullPath)) {
        fs.mkdirSync(path.dirname(manifestFullPath), { recursive: true });
        fs.writeFileSync(manifestFullPath, JSON.stringify(upstreamManifest, null, 2) + "\n", "utf8");
        console.log("➕ Created src/appsscript.json from upstream.");
        return true;
    }

    let localManifest;
    try {
        localManifest = JSON.parse(fs.readFileSync(manifestFullPath, "utf8"));
    } catch (err) {
        console.warn(`⚠️  Could not parse local src/appsscript.json (${err.message}), skipping smart-merge.`);
        return false;
    }

    const mergeBaseRef = getMergeBaseRef(sourceRef);
    const hasCommonBase = Boolean(mergeBaseRef);
    const baseManifest = hasCommonBase
        ? readGitJsonFile(mergeBaseRef, manifestRelPath)
        : (gitRefExists("HEAD") ? readGitJsonFile("HEAD", manifestRelPath) : null);

    const mergedManifest = threeWayMergeJson(
        baseManifest || {},
        localManifest,
        upstreamManifest,
        "root",
        hasCommonBase
    );

    const beforeStr = JSON.stringify(localManifest, null, 2) + "\n";
    const afterStr = JSON.stringify(mergedManifest, null, 2) + "\n";

    if (beforeStr !== afterStr) {
        fs.writeFileSync(manifestFullPath, afterStr, "utf8");
        console.log(`🔄 Smart-merged src/appsscript.json (${hasCommonBase ? "3-way via merge-base" : "3-way HEAD/local/upstream"}).`);
    }

    return true;
}

function updateFrameworkFromRemote() {
    const gitCheck = spawnSync("git", ["rev-parse", "--is-inside-work-tree"], {
        cwd: ROOT_DIR,
        encoding: "utf8"
    });
    if (gitCheck.status !== 0) {
        console.error("❌ Current directory is not a Git repository. Run 'git init' first before running 'gas framework:update'.");
        process.exit(1);
    }

    if (gitRefExists("MERGE_HEAD")) {
        console.error("❌ A Git merge is already in progress. Resolve or run 'git merge --abort' before running 'gas framework:update'.");
        process.exit(1);
    }

    const remoteName = getFlagValue("--remote") || "framework";
    const branch = getFlagValue("--branch") || "main";
    const repoUrl = getFlagValue("--repo") || "https://github.com/aqshalzuhdi/asal-gas.git";
    const dryRun = flags.includes("--dry-run");
    const autoCommit = flags.includes("--commit");
    const isReexec = flags.includes("--reexec");

    const userOwnedPrefixes = [
        "src/app/",
        "src/routes/",
        "src/resources/",
        "src/database/",
        "local/storage/",
        ".github/",
        ".vscode/"
    ];

    const userOwnedFiles = new Set([
        ".env",
        ".clasp.json",
        "creds.json",
        ".clasprc.json",
        "README.md",
        "package.json",
        "package-lock.json",
        "src/appsscript.json"
    ]);

    const mergeManagedFiles = new Set([
        ".gitignore",
        ".claspignore"
    ]);

    const managedFrameworkDirs = [
        "src/config",
        "src/core",
        "src/middleware",
        "src/tools",
        "local/runtime",
        "docs"
    ];

    const generatedCoreFiles = new Set([
        "src/core/CompiledViews.js"
    ]);

    const sourceRef = resolveRemoteSourceRef(remoteName, branch, repoUrl, isReexec);
    const allRemoteFiles = listAllFilesInGitTree(sourceRef);

    if (allRemoteFiles.length === 0) {
        console.error(`❌ No files found at ${sourceRef}.`);
        process.exit(1);
    }

    const isProtectedPath = (relPath) => {
        if (userOwnedFiles.has(relPath) || mergeManagedFiles.has(relPath)) return true;
        return userOwnedPrefixes.some((prefix) => relPath.startsWith(prefix));
    };

    const filesToSync = allRemoteFiles.filter((relPath) => !isProtectedPath(relPath));

    if (!isReexec) {
        console.log("🛡️  Protected project paths (preserved from HEAD):");
        [...userOwnedPrefixes, ...Array.from(userOwnedFiles)].forEach((p) => console.log(`   - ${p}`));
        console.log("🔀 Smart-merged files:");
        console.log("   - .gitignore, .claspignore (append missing rules)");
        console.log("   - .clasp.json (merge filePushOrder & defaults)");
        console.log("   - src/appsscript.json (3-way JSON merge preserving custom oauthScopes & settings)");
        console.log("   - package.json & package-lock.json (smart-merge version, scripts, bin & framework deps)");
        console.log(`📦 Discovered ${filesToSync.length} framework file(s) from ${sourceRef}.`);
    }

    if (dryRun) {
        filesToSync.forEach((f) => console.log(`   - ${f}`));
        console.log("\nℹ️  Dry run completed. No files were modified.");
        return;
    }

    if (!isReexec) {
        const statusRes = spawnSync("git", ["status", "--porcelain"], {
            cwd: ROOT_DIR,
            encoding: "utf8"
        });
        const dirtyEntries = String(statusRes.stdout || "")
            .split(/\r?\n/)
            .map((s) => s.trim())
            .filter(Boolean);

        if (dirtyEntries.length > 0) {
            console.error("❌ Uncommitted changes detected in working tree. Commit or stash your changes before running 'gas framework:update':");
            dirtyEntries.slice(0, 10).forEach((line) => console.error(`   ${line}`));
            if (dirtyEntries.length > 10) {
                console.error(`   ...and ${dirtyEntries.length - 10} more file(s).`);
            }
            process.exit(1);
        }
    }

    const hasHeadCommit = gitRefExists("HEAD");
    const bootstrapFiles = filesToSync.filter(
        (f) => f === "gas" || f === "gas.cmd" || f.startsWith("local/runtime/")
    );

    if (!isReexec && bootstrapFiles.length > 0) {
        checkoutFilesFromRef(sourceRef, bootstrapFiles);
        const forwardedArgs = rawArgs.filter((a) => a !== "--reexec");
        const reexecRes = spawnSync(
            process.execPath,
            [__filename, "framework:update", "--reexec", ...forwardedArgs],
            { cwd: ROOT_DIR, stdio: "inherit" }
        );
        process.exit(reexecRes.status || 0);
    }

    const prevCodeGenSource = hasHeadCommit
        ? readGitTextFile("HEAD", "src/tools/CodeGenerator.js")
        : (fs.existsSync(path.join(SRC_DIR, "tools", "CodeGenerator.js"))
            ? fs.readFileSync(path.join(SRC_DIR, "tools", "CodeGenerator.js"), "utf8")
            : null);

    let gitMergeRecorded = false;

    if (hasHeadCommit) {
        if (bootstrapFiles.length > 0) {
            restorePathsToHead(bootstrapFiles);
        }

        const mergeRes = spawnSync(
            "git",
            ["merge", "--no-commit", "--no-ff", "--allow-unrelated-histories", "-X", "theirs", sourceRef],
            { cwd: ROOT_DIR, encoding: "utf8" }
        );

        if (gitRefExists("MERGE_HEAD")) {
            gitMergeRecorded = true;

            const unmergedRes = spawnSync("git", ["diff", "--name-only", "--diff-filter=U"], {
                cwd: ROOT_DIR,
                encoding: "utf8"
            });
            const unmergedFiles = String(unmergedRes.stdout || "")
                .split(/\r?\n/)
                .map((s) => s.trim())
                .filter(Boolean);

            for (const file of unmergedFiles) {
                if (isProtectedPath(file)) {
                    restorePathsToHead([file]);
                } else {
                    spawnSync("git", ["checkout", "--theirs", "--", file], { cwd: ROOT_DIR, stdio: "ignore" });
                    spawnSync("git", ["add", "--", file], { cwd: ROOT_DIR, stdio: "ignore" });
                }
            }

            const stagedRes = spawnSync("git", ["diff", "--cached", "--name-only"], {
                cwd: ROOT_DIR,
                encoding: "utf8"
            });
            const stagedFiles = String(stagedRes.stdout || "")
                .split(/\r?\n/)
                .map((s) => s.trim())
                .filter(Boolean);

            const protectedToRestore = stagedFiles.filter((f) => isProtectedPath(f));
            restorePathsToHead(protectedToRestore);
        } else if (mergeRes.status !== 0) {
            console.warn("⚠️  Git merge could not be initiated. Falling back to file checkout...");
        }
    } else {
        console.warn("⚠️  No initial Git commit (HEAD) found. Syncing files without Git merge history.");
    }

    const remoteFileSet = new Set(allRemoteFiles);
    for (const dirTarget of managedFrameworkDirs) {
        const localFiles = listLocalFilesRecursive(dirTarget);
        for (const localFile of localFiles) {
            if (generatedCoreFiles.has(localFile)) continue;
            if (!remoteFileSet.has(localFile)) {
                fs.rmSync(path.join(ROOT_DIR, localFile), { force: true });
                if (gitMergeRecorded) {
                    spawnSync("git", ["rm", "-f", "--ignore-unmatch", localFile], { cwd: ROOT_DIR, stdio: "ignore" });
                }
                console.log(`🗑️  Removed obsolete file: ${localFile}`);
            }
        }
    }

    checkoutFilesFromRef(sourceRef, filesToSync);
    preserveCodeGeneratorTarget(prevCodeGenSource);

    for (const ignoreFile of mergeManagedFiles) {
        mergeIgnoreFileFromRef(sourceRef, ignoreFile);
    }

    const webRouteFile = path.join(SRC_DIR, "routes", "web.js");
    if (!fs.existsSync(webRouteFile)) {
        writeSrcFile(
            "routes/web.js",
            `function registerWebRoutes() {\n    Route.get("/", "HomeController@index");\n}\n`
        );
    }

    syncClaspConfigAfterUpdate();
    mergeAppsScriptManifestFromRef(sourceRef);
    if (ensureManifestScopes()) {
        console.log("🔄 Updated OAuth scopes & executionApi in src/appsscript.json.");
    }
    compileViews();

    const { remotePkg, needsNpmInstall } = syncPackageJsonFromRef(sourceRef);
    const localPkgPath = path.join(ROOT_DIR, "package.json");
    const localPkg = fs.existsSync(localPkgPath)
        ? JSON.parse(fs.readFileSync(localPkgPath, "utf8"))
        : {};

    if (needsNpmInstall) {
        console.log("📥 Running 'npm install' for updated framework dependencies...");
        const installRes = spawnBinSync("npm", ["install", "--no-audit", "--no-fund"], {
            stdio: "inherit"
        });
        if (installRes.status !== 0) {
            console.warn("⚠️  'npm install' exited with a non-zero status. Run 'npm install' manually if needed.");
        }
    }

    if (gitMergeRecorded) {
        const stageTargets = [
            ...filesToSync,
            ...Array.from(mergeManagedFiles),
            "src/appsscript.json",
            "package.json",
            "package-lock.json"
        ].filter((f) => fs.existsSync(path.join(ROOT_DIR, f)) && !gitIsIgnored(f));

        const chunkSize = 50;
        for (let i = 0; i < stageTargets.length; i += chunkSize) {
            spawnSync("git", ["add", "--", ...stageTargets.slice(i, i + chunkSize)], {
                cwd: ROOT_DIR,
                stdio: "ignore"
            });
        }
    }

    const versionLabel = remotePkg?.version ? ` (v${remotePkg.version})` : "";
    console.log(`\n✅ Framework files updated to latest version${versionLabel}.`);

    if (remotePkg) {
        const remoteDeps = Object.assign({}, remotePkg.dependencies, remotePkg.devDependencies);
        const localDeps = Object.assign({}, localPkg.dependencies, localPkg.devDependencies);
        const userOverrides = Object.entries(remoteDeps).filter(
            ([pkg, ver]) => localDeps[pkg] && localDeps[pkg] !== ver
        );

        if (userOverrides.length > 0) {
            console.log("ℹ️  Local dependency versions differ from framework defaults (kept as-is):");
            userOverrides.forEach(([pkg, ver]) => {
                console.log(`   - ${pkg}: local=${localDeps[pkg]} (framework=${ver})`);
            });
        }
    }

    const originUrlRes = spawnSync("git", ["remote", "get-url", "origin"], {
        cwd: ROOT_DIR,
        encoding: "utf8"
    });
    const originUrl = String(originUrlRes.stdout || "").trim();
    if (originUrl.includes("aqshalzuhdi/asal-gas")) {
        console.log("ℹ️  Note: 'origin' still points to asal-gas. Point 'origin' to your own GitHub repo before pushing:");
        console.log("   git remote set-url origin https://github.com/<username>/<your-repo>.git");
    }

    if (gitMergeRecorded) {
        const commitMsg = `chore(framework): merge Asal-GAS ${remotePkg?.version ? `v${remotePkg.version}` : branch} from ${sourceRef}`;
        if (autoCommit) {
            const commitRes = spawnSync("git", ["commit", "-m", commitMsg], {
                cwd: ROOT_DIR,
                stdio: "inherit"
            });
            if (commitRes.status === 0) {
                console.log(`🔒 Recorded Git merge commit (${branch}) so future 'git pull' will not overwrite project files.`);
            }
        } else {
            console.log("🔒 Git merge state staged (MERGE_HEAD active). Protected project files are preserved.");
            console.log(`👉 Review 'git status' & 'git diff --cached', then run:\n   git commit -m "${commitMsg}"`);
        }
    } else {
        console.log("👉 Review 'git status' & 'git diff', then commit your updated framework files.");
    }
}

(async function main() {
    switch (command) {
        case "-h":
        case "--h":
        case "--help":
        case "help":
        case undefined:
            printHelp();
            break;

        case "init":
        case "clasp:create":
            initGasProject(arg1);
            break;

        case "login":
            runClaspArgs(["login"]);
            break;

        case "creds": {
            const cfg = readClaspConfig();
            const forceReauth = flags.includes("-f") || flags.includes("--force");
            const ready = await setupRemoteCredentials(cfg, forceReauth);
            if (!ready) process.exit(1);
            break;
        }

        case "key:generate":
            await generateAppKeyCommand();
            break;

        case "push":
        case "clasp:push":
            await pushAndSyncGas();
            break;

        case "pull":
        case "clasp:pull":
            ensureClaspConfigured();
            runClaspArgs(["pull"]);
            break;

        case "status":
            ensureClaspConfigured();
            runClaspArgs(["show-file-status"]);
            break;

        case "open":
            openGasEditor();
            break;

        case "deploy":
            await deployGasWebApp(arg1);
            break;

        case "make:module": {
            if (!arg1 || hasFlag("-h", "--h", "--help")) {
                console.error("Usage: gas make:module Project [--api|-r|--resource]");
                process.exit(arg1 ? 0 : 1);
            }
            const entity = normalizeEntityName(arg1);
            const tablePascal = toPascalCase(pluralizeSnake(toSnakeCase(entity)));
            const modeFlag = resolveControllerMode("--api");
            createModel(entity);
            createMigration(`Create${tablePascal}Table`);
            createSeeder(entity);
            createController(`${entity}Controller`, modeFlag);
            break;
        }

        case "make:model": {
            if (!arg1 || hasFlag("-h", "--h", "--help")) {
                console.error("Usage: gas make:model Project [-m|--migration] [-c|--controller] [-s|--seeder] [-r|--resource] [-a|--all] [--api]");
                process.exit(arg1 ? 0 : 1);
            }
            const entity = normalizeEntityName(arg1);
            const tablePascal = toPascalCase(pluralizeSnake(toSnakeCase(entity)));
            const createAll = hasFlag("-a", "--all");
            const wantsResource = hasFlag("-r", "--resource");
            const wantsApi = hasFlag("--api");
            const wantsPlain = hasFlag("--plain", "--web");
            const modeFlag = wantsResource
                ? "--resource"
                : wantsPlain
                    ? "--plain"
                    : "--api";

            createModel(entity);

            if (createAll || hasFlag("-m", "--migration")) {
                createMigration(`Create${tablePascal}Table`);
            }
            if (createAll || hasFlag("-s", "--seeder")) {
                createSeeder(entity);
            }
            if (createAll || wantsResource || wantsApi || hasFlag("-c", "--controller")) {
                createController(`${entity}Controller`, modeFlag);
            }
            break;
        }

        case "make:migration":
            if (!arg1 || hasFlag("-h", "--h", "--help")) {
                console.error("Usage: gas make:migration CreateProjectsTable");
                process.exit(arg1 ? 0 : 1);
            }
            createMigration(arg1);
            break;

        case "make:controller": {
            if (!arg1 || hasFlag("-h", "--h", "--help")) {
                console.error("Usage: gas make:controller HomeController [--api|-r|--resource]");
                process.exit(arg1 ? 0 : 1);
            }
            const modeFlag = resolveControllerMode("--plain");
            createController(arg1, modeFlag);
            break;
        }

        case "make:seeder":
            if (!arg1 || hasFlag("-h", "--h", "--help")) {
                console.error("Usage: gas make:seeder ProjectSeeder");
                process.exit(arg1 ? 0 : 1);
            }
            createSeeder(arg1);
            break;

        case "make:view":
            if (!arg1 || hasFlag("-h", "--h", "--help")) {
                console.error("Usage: gas make:view home  (or users/create)");
                process.exit(arg1 ? 0 : 1);
            }
            createView(arg1);
            break;

        case "view:compile":
            compileViews();
            break;

        case "db:reindex": {
            bootGasRuntime();
            console.log(global.rebuildAllIndexes());
            break;
        }

        case "migrate": {
            bootGasRuntime();
            console.log(global.migrate());
            if (flags.includes("--seed")) {
                const ok = printSeederSummary(global.dbSeed(), "Local Seeder");
                if (!ok) process.exit(1);
            }
            break;
        }

        case "migrate:fresh": {
            fs.mkdirSync(path.dirname(DB_FILE), { recursive: true });
            fs.writeFileSync(DB_FILE, JSON.stringify({ sheets: {} }, null, 2));
            bootGasRuntime();
            console.log(global.migrateFresh());
            if (flags.includes("--seed")) {
                const ok = printSeederSummary(global.dbSeed(), "Local Seeder");
                if (!ok) process.exit(1);
            }
            break;
        }

        case "migrate:rollback": {
            bootGasRuntime();
            console.log(global.migrateRollback());
            break;
        }

        case "migrate:status": {
            bootGasRuntime();
            global.migrateStatus();
            break;
        }

        case "migrate:remote":
        case "migrate:remote:rollback":
        case "migrate:remote:refresh": {
            const cfg = readClaspConfig();
            const ready = await setupRemoteCredentials(cfg, false);
            if (!ready) process.exit(1);

            const isRefresh = command === "migrate:remote:refresh";
            const isRollback = !isRefresh && (command === "migrate:remote:rollback" || flags.includes("--rollback"));
            const shouldSeed = flags.includes("--seed");

            if (isRollback || isRefresh) {
                console.log("☁️  Rolling back last migration batch on Google Apps Script...");
                const rbRes = tryClaspRun("migrateRollback", null, true);
                if (rbRes && rbRes.__gasException) {
                    process.exit(1);
                }
                if (!rbRes) {
                    console.error("❌ No valid response received from Google Apps Script. Ensure the latest code is pushed ('gas push -f') and an API Executable deployment is active.");
                    process.exit(1);
                }
                printRemoteRollback(rbRes);
                if (isRollback) break;
            }

            console.log(
                shouldSeed
                    ? "☁️  Running remote migration and seeder on Google Apps Script..."
                    : "☁️  Running remote migration on Google Apps Script..."
            );

            const appEnv = filterAppEnv(loadLocalEnv(path.join(ROOT_DIR, ".env")));
            const res = tryClaspRun(
                "setupWorkspace",
                {
                    env: appEnv,
                    envMode: "keep",
                    sheetMode: "keep",
                    migrate: true,
                    seed: shouldSeed,
                    webAppUrl: resolveBaseUrl(appEnv, cfg.webAppUrl || "")
                },
                true
            );

            if (res && res.__gasException) {
                process.exit(1);
            }

            if (!res || typeof res !== "object") {
                console.error("❌ No valid response received from Google Apps Script. Ensure the latest code is pushed ('gas push -f') and an API Executable deployment is active.");
                process.exit(1);
            }

            if (!res.status) {
                console.error(`❌ Remote migration failed: ${res.message || JSON.stringify(res)}`);
                process.exit(1);
            }

            printRemoteMigration(res.migration);

            if (shouldSeed) {
                printSeederSummary(res.seeder, "Remote Seeder");
            }

            if (res.SHEET_ID) {
                console.log(`📄 Target Sheet  : ${res.SHEET_URL || res.SHEET_ID}`);
            }
            break;
        }

        case "db:seed":
        case "db:seed:remote": {
            const isRemote = command === "db:seed:remote" || flags.includes("--remote");
            const seederClass = arg1 || getFlagValue("--class") || null;

            if (!isRemote) {
                bootGasRuntime();
                const localRes = seederClass ? global.dbSeed(seederClass) : global.dbSeed();
                const ok = printSeederSummary(localRes, "Local Seeder");
                if (!ok) process.exit(1);
                break;
            }

            const cfg = readClaspConfig();
            const ready = await setupRemoteCredentials(cfg, false);
            if (!ready) process.exit(1);

            console.log(
                seederClass
                    ? `☁️  Running remote seeder (${seederClass}) on Google Apps Script...`
                    : "☁️  Running remote seeder on Google Apps Script..."
            );

            const seedRes = tryClaspRun("dbSeed", seederClass, true);

            if (seedRes && seedRes.__gasException) {
                process.exit(1);
            }

            if (!seedRes) {
                console.error("❌ No valid response received from Google Apps Script. Ensure the latest code is pushed ('gas push -f') and an API Executable deployment is active.");
                process.exit(1);
            }

            const ok = printSeederSummary(seedRes, "Remote Seeder");
            if (!ok) process.exit(1);
            break;
        }

        case "framework:update":
            updateFrameworkFromRemote();
            break;

        case "route:list":
            listRoutes();
            break;

        default:
            console.error(`❌ Unknown command: ${command}`);
            printHelp();
            process.exit(1);
    }
})();
