    if (res && res.status === false) {
        console.error(`❌ Remote rollback failed: ${res.message || JSON.stringify(res)}`);
        process.exit(1);
    }

    const list = Array.isArray(res?.rolled_back)
        ? res.rolled_back
        : Array.isArray(res?.rolledBack)
            ? res.rolledBack
            : null;

    if (list && list.length === 0) {
