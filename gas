function isFile(filePath) {
    try {
        return fs.existsSync(filePath) && fs.statSync(filePath).isFile();
    } catch (_) {
        return false;
    }
}

function isSameFile(a, b) {
    try {
        const realA = fs.realpathSync(a);
        const realB = fs.realpathSync(b);
        return process.platform === "win32"
            ? realA.toLowerCase() === realB.toLowerCase()
            : realA === realB;
    } catch (_) {
        return false;
    }
}

function findProjectRoot(startDir) {
    const start = path.resolve(startDir);

    let dir = start;
    while (true) {
        if (isFile(path.join(dir, "gas")) || isFile(path.join(dir, ".clasp.json"))) {
            return dir;
        }
        const parent = path.dirname(dir);
        if (parent === dir) break;
        dir = parent;
    }

    dir = start;
    while (true) {
        if (
            isFile(path.join(dir, "src", "appsscript.json")) ||
            isFile(path.join(dir, "local", "runtime", "GasLoader.js"))
        ) {
            return dir;
        }
        const parent = path.dirname(dir);
        if (parent === dir) break;
        dir = parent;
    }

    return null;
}

