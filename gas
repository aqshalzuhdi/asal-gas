function resolveWebAppDeployment(cfg) {
    if (cfg.deploymentId && cfg.webAppUrl) {
        return { deploymentId: cfg.deploymentId, webAppUrl: cfg.webAppUrl };
    }

    try {
        console.log("🔍 Checking Web App deployments...");
        const output = execSync("npx --quiet clasp deployments", { cwd: ROOT_DIR, encoding: "utf8" });
        const matches = [...output.matchAll(/-\s+(AKfycb[a-zA-Z0-9_-]+)\s+@(\d+)/g)];
        if (matches.length > 0) {
            matches.sort((a, b) => Number(b[2]) - Number(a[2]));
            const deploymentId = matches[0][1];
            const webAppUrl = `https://script.google.com/macros/s/${deploymentId}/exec`;
            cfg.deploymentId = deploymentId;
            cfg.webAppUrl = webAppUrl;
            writeClaspConfig(cfg);
            return { deploymentId, webAppUrl };
        }
    } catch (_) { }

    return null;
}

function syncApiExecutableDeployment(cfg) {
    let apiDeploymentId = cfg.apiDeploymentId || "";

    if (!apiDeploymentId) {
        try {
            console.log("🔍 Checking API Executable deployment...");
            const output = execSync("npx --quiet clasp deployments", { cwd: ROOT_DIR, encoding: "utf8" });
            const candidates = [];

            for (const line of output.split(/\r?\n/)) {
                if (line.toLowerCase().includes("web app meta-version")) continue;
                const match = line.match(/-\s+(AKfycb[a-zA-Z0-9_-]+)\s+@(\d+)/);
                if (!match) continue;

                const depId = match[1];
                const version = Number(match[2]);
                if (cfg.deploymentId && depId === cfg.deploymentId) continue;

                candidates.push({
                    depId,
                    version,
                    isApiLabel: line.toLowerCase().includes("api executable")
                });
            }

            if (candidates.length > 0) {
                candidates.sort((a, b) => {
                    if (a.isApiLabel !== b.isApiLabel) return a.isApiLabel ? -1 : 1;
                    return b.version - a.version;
                });
                apiDeploymentId = candidates[0].depId;
                cfg.apiDeploymentId = apiDeploymentId;
                writeClaspConfig(cfg);
            }
        } catch (_) { }
    }

    if (!apiDeploymentId) {
        console.log("⚠️  No API Executable deployment found. Create one in GAS Editor -> Deploy -> New deployment -> API Executable.");
        return;
    }

    const res = spawnSync(`npx --quiet clasp deploy -i ${apiDeploymentId} -d "API Executable"`, {
        cwd: ROOT_DIR,
        encoding: "utf8",
        shell: true,
        stdio: ["ignore", "pipe", "pipe"]
    });

    const out = String(res.stdout || "").trim();
    const err = String(res.stderr || "").trim();

    if (res.status === 0) {
        const verMatch = out.match(/@(\d+)/);
        const verLabel = verMatch ? ` @${verMatch[1]}` : "";
        console.log(`🔄 Updated API Executable deployment (${apiDeploymentId}${verLabel}).`);
    } else {
        delete cfg.apiDeploymentId;
        writeClaspConfig(cfg);
        console.error(`⚠️  Failed to update API Executable deployment (${apiDeploymentId}): ${err || out}`);
    }
}

function askQuestion(promptText) {
    const rl = readline.createInterface({
        input: process.stdin,
        output: process.stdout
