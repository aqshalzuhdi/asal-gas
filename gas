async function ensureProjectId(cfg) {
    const existingCreds = readCredsFile();
    const credsProjectId = existingCreds?.installed?.project_id;

    if (!cfg.projectId && credsProjectId && credsProjectId !== "your-gcp-project-id") {
        cfg.projectId = credsProjectId;
        writeClaspConfig(cfg);
        return cfg.projectId;
    }

    if (!cfg.projectId || cfg.projectId === "your-gcp-project-id") {
        console.log("⚠️  GCP 'projectId' is not configured in .clasp.json.");
        const inputId = await askQuestion("Enter your Google Cloud Project ID (e.g. my-gas-project-12345): ");
        if (!inputId) {
            console.error("❌ GCP Project ID is required for remote execution.");
            process.exit(1);
        }
        cfg.projectId = inputId;
        writeClaspConfig(cfg);
        console.log(`✅ Saved projectId '${inputId}' to .clasp.json.`);
    }

    return cfg.projectId;
}

function runClaspLoginWithCreds() {
    return new Promise((resolve) => {
        const child = spawn("npx clasp login --creds creds.json", {
            cwd: ROOT_DIR,
            shell: true,
            stdio: ["inherit", "pipe", "pipe"]
        });

        let output = "";
        let completed = false;

        const finishLogin = () => {
            if (completed) return;
            completed = true;
            clearInterval(pollTimer);
            setTimeout(() => {
                try {
                    if (process.platform === "win32" && child.pid) {
                        spawnSync("taskkill", ["/PID", String(child.pid), "/T", "/F"], { stdio: "ignore" });
                    } else {
                        child.kill("SIGKILL");
                    }
                } catch (_) { }
                resolve(true);
            }, 600);
        };

        child.stdout.on("data", (chunk) => {
            output += chunk.toString();
            process.stdout.write(chunk);
            if (output.includes("You are logged in as")) {
                finishLogin();
            }
        });

        child.stderr.on("data", (chunk) => {
            output += chunk.toString();
            process.stderr.write(chunk);
            if (output.includes("You are logged in as")) {
                finishLogin();
            }
        });

        const pollTimer = setInterval(() => {
            const localRc = path.join(ROOT_DIR, ".clasprc.json");
            if (fs.existsSync(localRc)) {
                try {
                    const raw = fs.readFileSync(localRc, "utf8");
                    if (raw.includes("access_token") && raw.includes("refresh_token")) {
                        finishLogin();
                    }
                } catch (_) { }
            }
        }, 500);

        child.on("close", (code) => {
            clearInterval(pollTimer);
            if (completed) return;
            if (code === 0) {
                resolve(true);
            } else {
                process.exit(code || 1);
            }
        });
    });
}

async function setupRemoteCredentials(cfg, forceReauth = false) {
