        return true;
    }

    if (seeder.status === false) {
        console.error(`❌ ${label}: ${seeder.message || JSON.stringify(seeder)}`);
        return false;
    }

    if (Array.isArray(seeder.results)) {
        const items = seeder.results
            .flat(Infinity)
            .filter((item) => item !== null && item !== undefined);

        if (items.length === 0) {
            console.log(`✅ ${label}: ${seeder.message || "Database seeded successfully."}`);
            return true;
        }

        const formatted = items.map((item) => formatSeederEntry(item, hideCount)).filter(Boolean);
        const summary = formatted.length > 0
            ? formatted.join(", ")
            : (seeder.message || "Database seeded successfully.");

        console.log(`✅ ${label}: ${summary}`);
        return true;
    }

    const single = formatSeederEntry(seeder, hideCount);
    if (single) {
        console.log(`✅ ${label}: ${single}`);
        return true;
    }

    if (seeder.message) {
        console.log(`✅ ${label}: ${seeder.message}`);
    } else {
        console.log(`✅ ${label}: ${JSON.stringify(seeder)}`);
    }
    return true;
}

