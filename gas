function parseClaspRunOutput(rawOut) {
    const text = String(rawOut || "").trim();
    if (!text) return null;

    const firstBrace = text.indexOf("{");
    const lastBrace = text.lastIndexOf("}");
    if (firstBrace === -1 || lastBrace === -1 || lastBrace <= firstBrace) {
        return null;
    }

    const candidate = text.slice(firstBrace, lastBrace + 1);
    try {
        return JSON.parse(candidate);
    } catch (_) {
        try {
            const evaluated = vm.runInNewContext(`(${candidate})`, Object.create(null), { timeout: 100 });
            if (evaluated && typeof evaluated === "object") {
                return JSON.parse(JSON.stringify(evaluated));
            }
        } catch (__) { }
        return null;
    }
}

function extractGasException(combinedText) {
    const idx = combinedText.indexOf("Exception:");
    if (idx === -1) return null;

    return combinedText
        .slice(idx)
        .replace(/^Exception:\s*Exception:\s*/i, "Exception: ")
        .trim();
}

function tryClaspRun(fnName, payloadObj, verbose = false) {
    const hasPayload = payloadObj !== null && payloadObj !== undefined;
    const args = ["--quiet", "clasp", "run", fnName];
    if (hasPayload) {
        args.push("-p", JSON.stringify([payloadObj]));
    }

    const proc = spawnBinSync("npx", args, {
        encoding: "utf8",
        stdio: ["ignore", "pipe", "pipe"]
    });

    const stdout = String(proc.stdout || "").trim();
    const stderr = String(proc.stderr || "")
        .split(/\r?\n/)
        .filter((line) => !line.trim().startsWith("npm notice"))
        .join("\n")
        .trim();
    const combined = [stderr, stdout].filter(Boolean).join("\n");

    const gasException = extractGasException(combined);
    if (gasException) {
        if (verbose) {
            console.error(`❌ GAS ${gasException}`);
            if (gasException.includes("Required permissions:")) {
                console.error("👉 Run 'gas push -f' and 'gas creds --force' (check all permission boxes in browser) to grant the required scopes.");
            }
        }
        return { __gasException: gasException };
    }

    const parsed = parseClaspRunOutput(stdout);
    if (parsed) {
        return parsed;
    }

    if (proc.status === 0 && stdout) {
        return stdout;
    }

    if (verbose) {
        if (proc.status !== 0) {
            console.error(`❌ clasp run ${fnName} failed (exit code ${proc.status}):\n${combined || "(no output)"}`);
        } else {
            console.log(`ℹ️  Raw clasp output:\n${combined || "(empty response)"}`);
        }
    }

    return null;
}

