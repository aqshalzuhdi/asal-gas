async function pushAndSyncGas() {
    const cfg = readClaspConfig();
    const isForce = flags.includes("-f") || flags.includes("--force");
    const shouldSeed = flags.includes("--seed");
    const showSetup = flags.includes("--setup");

    compileViews();
    runClaspArgs(isForce ? ["push", "-f"] : ["push"]);
    syncApiExecutableDeployment(cfg);

    const remoteState = inspectRemoteWorkspace();
    const plan = await resolveDeploySyncPlan(cfg, remoteState);
    const baseUrl = resolveBaseUrl(plan.appEnv, cfg.webAppUrl || "");

    const remoteRes = tryClaspRun("setupWorkspace", {
        env: plan.appEnv,
        envMode: plan.envMode,
        sheetMode: plan.sheetMode,
        customSheetId: plan.customSheetId,
        appKey: plan.appKey,
        forceAppKey: plan.forceAppKey,
        autoGenerateKey: plan.autoGenerateKey,
        fresh: plan.fresh,
        migrate: true,
        seed: shouldSeed,
        webAppUrl: baseUrl
    });

    if (remoteRes && !remoteRes.__gasException && remoteRes.status) {
        const envPath = path.join(ROOT_DIR, ".env");
        if (remoteRes.SHEET_ID && (remoteRes.generated_sheet || !readEnvKey(envPath, "SHEET_ID"))) {
            upsertEnvKey(envPath, "SHEET_ID", remoteRes.SHEET_ID);
        }
        if (remoteRes.APP_KEY && (remoteRes.generated_app_key || !readEnvKey(envPath, "APP_KEY"))) {
            upsertEnvKey(envPath, "APP_KEY", remoteRes.APP_KEY);
        }
        if (remoteRes.APP_KEY) {
            cfg.appKey = remoteRes.APP_KEY;
        }
        cfg.initialized = true;
        writeClaspConfig(cfg);

        printRemoteMigration(remoteRes.migration);
        if (shouldSeed) {
            printSeederSummary(remoteRes.seeder, "Remote Seeder");
        }
        if (remoteRes.first_setup || remoteRes.generated_sheet || remoteRes.generated_app_key || showSetup) {
            printSetupSummary(remoteRes, baseUrl, true);
        }
        return;
    }

    if (!cfg.initialized || showSetup) {
        printManualSetupReminder(baseUrl);
        cfg.initialized = true;
        writeClaspConfig(cfg);
    }
}

async function deployGasWebApp(description) {
    const cfg = readClaspConfig();
    const desc = (description || "Deploy via GAS CLI").trim();
    const showSetup = flags.includes("--setup");
    const shouldMigrate = flags.includes("--migrate");
    const shouldSeed = flags.includes("--seed");

    if (shouldMigrate || shouldSeed) {
        const ready = await setupRemoteCredentials(cfg, false);
        if (!ready) process.exit(1);
    }

    console.log("📦 Pushing latest code to Google Apps Script...");
    compileViews();
    runClaspArgs(["push", "-f"]);

    const existing = resolveWebAppDeployment(cfg);
    const deployArgs = existing
        ? ["clasp", "deploy", "-i", existing.deploymentId, "-d", desc]
        : ["clasp", "deploy", "-d", desc];

    console.log(existing
        ? `🔄 Updating Web App deployment (${existing.deploymentId})...`
        : "🚀 Creating new Web App deployment...");

    let deploymentId = existing?.deploymentId || "";
    const deployProc = spawnBinSync("npx", deployArgs, {
        encoding: "utf8",
        stdio: ["ignore", "pipe", "pipe"]
    });

    const out = String(deployProc.stdout || "");
    const err = String(deployProc.stderr || "");
    if (out) process.stdout.write(out);
    if (err) process.stderr.write(err);

    if (deployProc.status !== 0) {
        process.exit(deployProc.status || 1);
    }

    const match = `${out}\n${err}`.match(/(AKfycb[a-zA-Z0-9_-]+)/);
    if (match) deploymentId = match[1];

    if (!deploymentId) {
        console.error("❌ Failed to retrieve Deployment ID from clasp output.");
        process.exit(1);
    }

    const webAppUrl = `https://script.google.com/macros/s/${deploymentId}/exec`;
    cfg.deploymentId = deploymentId;
    cfg.webAppUrl = webAppUrl;
    writeClaspConfig(cfg);
    console.log(`🌐 Web App URL: ${webAppUrl}`);

    syncApiExecutableDeployment(cfg);

    const remoteState = inspectRemoteWorkspace();
    const plan = await resolveDeploySyncPlan(cfg, remoteState);
    const baseUrl = resolveBaseUrl(plan.appEnv, webAppUrl);

    if (baseUrl !== webAppUrl) {
        console.log(`🔗 Base URL   : ${baseUrl}`);
    }

    const bootRes = tryClaspRun(
        "setupWorkspace",
        {
            webAppUrl: baseUrl,
            env: plan.appEnv,
            envMode: plan.envMode,
            sheetMode: plan.sheetMode,
            customSheetId: plan.customSheetId,
            appKey: plan.appKey,
            forceAppKey: plan.forceAppKey,
            autoGenerateKey: plan.autoGenerateKey,
            fresh: plan.fresh,
            migrate: shouldMigrate,
            seed: shouldSeed
        },
        shouldMigrate || shouldSeed
    );

    if (bootRes && bootRes.__gasException) {
        process.exit(1);
    }

    if (bootRes && bootRes.status) {
        const envPath = path.join(ROOT_DIR, ".env");
        if (bootRes.SHEET_ID && (bootRes.generated_sheet || !readEnvKey(envPath, "SHEET_ID"))) {
            upsertEnvKey(envPath, "SHEET_ID", bootRes.SHEET_ID);
        }
        if (bootRes.APP_KEY && (bootRes.generated_app_key || !readEnvKey(envPath, "APP_KEY"))) {
            upsertEnvKey(envPath, "APP_KEY", bootRes.APP_KEY);
        }
        if (bootRes.APP_KEY) {
            cfg.appKey = bootRes.APP_KEY;
        }
        cfg.initialized = true;
        writeClaspConfig(cfg);

        if (shouldMigrate) {
            printRemoteMigration(bootRes.migration);
        }
        if (shouldSeed) {
            printSeederSummary(bootRes.seeder, "Remote Seeder");
        }
        printSetupSummary(bootRes, baseUrl, true);
        return;
    }

    if (!cfg.initialized || showSetup) {
        printManualSetupReminder(baseUrl);
        cfg.initialized = true;
        writeClaspConfig(cfg);
    }
}

