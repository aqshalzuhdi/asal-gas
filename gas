function formatSeederEntry(item, hideCount = false) {
    if (typeof item === "string") return item;
    if (!item || typeof item !== "object") return null;

    const hasCount = !hideCount && item.count !== undefined && item.count !== null;
    const hasTable = item.table !== undefined && item.table !== null && item.table !== "";

    if (hasTable && hasCount) {
        return `${item.table} (${item.count} records)`;
    }

    if (hasTable) {
        return `${item.table}`;
    }

    if (hasCount) {
        return `${item.count} records`;
    }

    if (item.seeder) {
        const inner = Array.isArray(item.result)
            ? item.result.flat(Infinity).filter((v) => v !== null && v !== undefined)
            : item.result !== null && item.result !== undefined
                ? [item.result]
                : [];

        if (inner.length === 0) {
            return `${item.seeder} (seeded)`;
        }

        const innerText = inner.map((v) => formatSeederEntry(v, hideCount)).filter(Boolean).join(", ");
        if (!innerText) {
            return `${item.seeder} (seeded)`;
        }

        return innerText.startsWith("(")
            ? `${item.seeder} ${innerText}`
            : `${item.seeder} -> ${innerText}`;
    }

    return null;
}

function printSeederSummary(seeder, label = "Remote Seeder") {
    const hideCount = flags.includes("--no-count");

    if (!seeder) {
        console.error(`❌ ${label}: No seeder status returned.`);
        return false;
    }

    if (typeof seeder === "string") {
        console.log(`✅ ${label}: ${seeder}`);
        return true;
    }

    if (seeder.status === false) {
        console.error(`❌ ${label}: ${seeder.message || JSON.stringify(seeder)}`);
        return false;
    }

    if (Array.isArray(seeder.results)) {
        const items = seeder.results
            .flat(Infinity)
            .filter((item) => item !== null && item !== undefined);

        if (items.length === 0) {
            console.log(`✅ ${label}: ${seeder.message || "Database seeded successfully."}`);
            return true;
        }

        const formatted = items.map((item) => formatSeederEntry(item, hideCount)).filter(Boolean);
        const summary = formatted.length > 0
            ? formatted.join(", ")
            : (seeder.message || "Database seeded successfully.");

        console.log(`✅ ${label}: ${summary}`);
        return true;
    }

    const single = formatSeederEntry(seeder, hideCount);
    if (single) {
        console.log(`✅ ${label}: ${single}`);
        return true;
    }

    if (seeder.message) {
        console.log(`✅ ${label}: ${seeder.message}`);
    } else {
        console.log(`✅ ${label}: ${JSON.stringify(seeder)}`);
    }
    return true;
}

