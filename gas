function quoteWindowsCmdArg(arg) {
    const str = String(arg);
    if (str === "") return '""';
    if (!/[\s"&|<>^()%!]/.test(str)) return str;
    return `"${str.replace(/(\\*)"/g, '$1$1\\"').replace(/(\\+)$/, "$1$1")}"`;
}

function spawnBinSync(binName, args = [], options = {}) {
    const isWin = process.platform === "win32";
    if (isWin) {
        const cmdBin = binName.endsWith(".cmd") ? binName : `${binName}.cmd`;
        const fullCmd = [cmdBin, ...args.map(quoteWindowsCmdArg)].join(" ");
        return spawnSync(fullCmd, {
            cwd: ROOT_DIR,
            shell: true,
            ...options
        });
    }
    return spawnSync(binName, args, {
        cwd: ROOT_DIR,
        shell: false,
        ...options
    });
}

function openExternalUrl(targetUrl) {
    const isWin = process.platform === "win32";
    const isMac = process.platform === "darwin";
    try {
        if (isWin) {
            spawnSync(`start "" ${quoteWindowsCmdArg(targetUrl)}`, {
                stdio: "ignore",
                shell: true
            });
        } else {
            spawnSync(isMac ? "open" : "xdg-open", [targetUrl], {
                stdio: "ignore",
                shell: false
            });
        }
    } catch (_) { }
}

function toPascalCase(str) {
    return String(str || "")
        .replace(/[^a-zA-Z0-9]+/g, " ")
        .trim()
        .split(/\s+/)
        .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
        .join("");
}

function toSnakeCase(str) {
    return String(str || "")
        .replace(/([a-z0-9])([A-Z])/g, "$1_$2")
        .replace(/[^a-zA-Z0-9]+/g, "_")
        .replace(/^_+|_+$/g, "")
        .toLowerCase();
}

function pluralizeSnake(singular) {
    if (/[^aeiou]y$/.test(singular)) return singular.replace(/y$/, "ies");
    if (/(s|x|z|ch|sh)$/.test(singular)) return singular + "es";
    return singular + "s";
}

function timestamp() {
    const d = new Date();
    const pad = (n) => String(n).padStart(2, "0");
    return `${d.getFullYear()}_${pad(d.getMonth() + 1)}_${pad(d.getDate())}_${pad(d.getHours())}${pad(d.getMinutes())}${pad(d.getSeconds())}`;
}

function hasFlag(...names) {
    return names.some((name) => {
        if (flags.includes(name)) return true;
        if (/^-[a-zA-Z]$/.test(name)) {
            const shortChar = name.slice(1);
            return flags.some((f) => /^-[a-zA-Z]{2,}$/.test(f) && f.includes(shortChar));
        }
        return false;
    });
}

function getFlagValue(flagName) {
    const idx = rawArgs.indexOf(flagName);
    if (idx !== -1 && rawArgs[idx + 1] && !rawArgs[idx + 1].startsWith("-")) {
        return rawArgs[idx + 1];
    }
    const prefix = `${flagName}=`;
    const inline = rawArgs.find((a) => a.startsWith(prefix));
    return inline ? inline.slice(prefix.length) : null;
}

function resolveControllerMode(defaultMode = "--plain") {
    if (hasFlag("--resource", "-r")) {
        return "--resource";
    }
    if (hasFlag("--api")) {
        return "--api";
    }
    if (hasFlag("--plain", "--web")) {
        return "--plain";
    }
    return defaultMode;
}

