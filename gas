function generateAppKey() {
    return "base64:" + crypto.randomBytes(32).toString("base64");
}

function readEnvKey(envPath, key) {
    if (!fs.existsSync(envPath)) return "";
    const content = fs.readFileSync(envPath, "utf8");
    const regex = new RegExp(`^\\s*${key}\\s*=\\s*(.*)\\s*$`, "m");
    const match = content.match(regex);
    if (!match) return "";
    return match[1].trim().replace(/^["']|["']$/g, "");
}

function upsertEnvKey(envPath, key, value) {
    let lines = fs.existsSync(envPath)
        ? fs.readFileSync(envPath, "utf8").split(/\r?\n/)
        : [];

    const pattern = new RegExp(`^\\s*${key}\\s*=`);
    let replaced = false;
    lines = lines.map((line) => {
        if (pattern.test(line)) {
            replaced = true;
            return `${key}="${value}"`;
        }
        return line;
    });

    if (!replaced) {
        if (lines.length && lines[lines.length - 1] !== "") {
            lines.push("");
        }
        lines.push(`${key}="${value}"`);
    }

    fs.writeFileSync(envPath, lines.join("\n").replace(/\n*$/, "\n"), "utf8");
}

function filterAppEnv(rawEnv) {
    const filtered = {};
    if (!rawEnv || typeof rawEnv !== "object") return filtered;
    for (const [k, v] of Object.entries(rawEnv)) {
        const cleanKey = String(k || "").trim();
        if (!cleanKey || cleanKey.startsWith("GAS_DEPLOY_")) continue;
        filtered[cleanKey] = v;
    }
    return filtered;
}

function resolveBaseUrl(envObj, fallbackUrl = "") {
    const envBaseUrl = String((envObj && envObj.BASE_URL) || "").trim().replace(/\/+$/g, "");
    return envBaseUrl || String(fallbackUrl || "").trim().replace(/\/+$/g, "");
}

function inspectRemoteWorkspace() {
    const direct = tryClaspRun("inspectWorkspace", null, false);
    if (direct && !direct.__gasException && typeof direct === "object" && direct.status) {
        return direct;
    }
    const fallback = tryClaspRun("setupWorkspace", { dryRun: true }, false);
    if (fallback && !fallback.__gasException && typeof fallback === "object" && fallback.status) {
        return fallback;
    }
    return null;
}

function computeEnvDiff(appEnv, remoteProps) {
    const protectedKeys = new Set(["SHEET_ID", "APP_KEY", "BASE_URL"]);
    const added = [];
    const changed = [];

    for (const [key, rawVal] of Object.entries(appEnv)) {
        if (protectedKeys.has(key)) continue;
        const localVal = String(rawVal ?? "").trim();
        if (localVal === "") continue;

        const hasRemote = Object.prototype.hasOwnProperty.call(remoteProps, key) &&
            String(remoteProps[key] ?? "").trim() !== "";
        const remoteVal = hasRemote ? String(remoteProps[key]).trim() : "";

        if (!hasRemote) {
            added.push(key);
        } else if (remoteVal !== localVal) {
            changed.push(key);
        }
    }

    return { added, changed };
}

