        printCredsManualGuide(projectId);

        console.log("Paste your OAuth Desktop credentials below (from Step 4),");
        console.log("or press Enter to generate an empty ./creds.json template first.\n");

        const clientId = await askQuestion("Enter OAuth Client ID (*.apps.googleusercontent.com): ");
        if (clientId) {
            const clientSecret = await askQuestion("Enter OAuth Client Secret: ");
            writeCredsFile(projectId, clientId, clientSecret);
            console.log("✅ Generated ./creds.json.");
            creds = readCredsFile();
        } else {
            writeCredsFile(projectId, "", "");
            console.log("📄 Generated template at ./creds.json.");
            console.log("👉 Fill in 'client_id' and 'client_secret' (or overwrite with downloaded JSON), then run 'gas creds'.");
            return false;
        }
    }

    const installed = creds?.installed || {};
    const clientId = String(installed.client_id || "").trim();
    const clientSecret = String(installed.client_secret || "").trim();

    if (!clientId || !clientSecret || clientId.startsWith("YOUR_") || clientSecret.startsWith("YOUR_")) {
        console.error("❌ ./creds.json contains empty or placeholder credentials.");
        printCredsManualGuide(projectId);
        console.log("👉 Update 'client_id' and 'client_secret' in ./creds.json, then run 'gas creds'.");
        return false;
    }

    if (installed.project_id !== projectId) {
        writeCredsFile(projectId, clientId, clientSecret);
    }

    const manifestUpdated = ensureManifestScopes();

    if (forceReauth || !isClaspCredsLoggedIn(clientId)) {
        console.log("🔐 Authenticating clasp with ./creds.json...");
        clearClaspSessions();

        const srcManifest = path.join(SRC_DIR, "appsscript.json");
        const rootManifest = path.join(ROOT_DIR, "appsscript.json");
        const copiedTempManifest = !fs.existsSync(rootManifest) && fs.existsSync(srcManifest);

        try {
            if (copiedTempManifest) {
                fs.copyFileSync(srcManifest, rootManifest);
            }
            await runClaspLoginWithCreds();
        } finally {
            if (copiedTempManifest && fs.existsSync(rootManifest)) {
                try { fs.rmSync(rootManifest, { force: true }); } catch (_) { }
            }
        }

        if (!isClaspCredsLoggedIn(clientId)) {
            const rcPath = findClaspRcFile() || path.join(os.homedir(), ".clasprc.json");
            await authorizeScopesFallback(creds, rcPath);
        }

        if (!isClaspCredsLoggedIn(clientId)) {
            console.error("❌ Failed to store local OAuth credentials with required scopes in .clasprc.json.");
            return false;
        }

        console.log("📦 Syncing manifest scopes to Google Apps Script...");
        compileViews();
        runClaspCommand("push -f");
        syncApiExecutableDeployment(cfg);
        console.log("✅ clasp authenticated with ./creds.json.");
    } else if (manifestUpdated) {
        compileViews();
        runClaspCommand("push -f");
        syncApiExecutableDeployment(cfg);
    }

    return true;
}

function parseClaspRunOutput(rawOut) {
    const text = String(rawOut || "").trim();
    if (!text) return null;

    const firstBrace = text.indexOf("{");
    const lastBrace = text.lastIndexOf("}");
    if (firstBrace === -1 || lastBrace === -1 || lastBrace <= firstBrace) {
        return null;
    }

    const candidate = text.slice(firstBrace, lastBrace + 1);
    try {
        return JSON.parse(candidate);
    } catch (_) {
        try {
            const evaluated = vm.runInNewContext(`(${candidate})`, Object.create(null), { timeout: 100 });
            if (evaluated && typeof evaluated === "object") {
                return JSON.parse(JSON.stringify(evaluated));
            }
        } catch (__) { }
        return null;
    }
}

function extractGasException(combinedText) {
    const idx = combinedText.indexOf("Exception:");
    if (idx === -1) return null;

    return combinedText
        .slice(idx)
        .replace(/^Exception:\s*Exception:\s*/i, "Exception: ")
        .trim();
}

function tryClaspRun(fnName, payloadObj, verbose = false) {
    const hasPayload = payloadObj !== null && payloadObj !== undefined;
    const argsPart = hasPayload
        ? ` -p "${JSON.stringify([payloadObj]).replace(/"/g, '\\"')}"`
        : "";

    const proc = spawnSync(`npx --quiet clasp run ${fnName}${argsPart}`, {
        cwd: ROOT_DIR,
        encoding: "utf8",
        shell: true,
        stdio: ["ignore", "pipe", "pipe"]
    });

    const stdout = String(proc.stdout || "").trim();
    const stderr = String(proc.stderr || "")
        .split(/\r?\n/)
        .filter((line) => !line.trim().startsWith("npm notice"))
        .join("\n")
        .trim();
    const combined = [stderr, stdout].filter(Boolean).join("\n");

    const gasException = extractGasException(combined);
    if (gasException) {
        if (verbose) {
            console.error(`❌ GAS ${gasException}`);
            if (gasException.includes("Required permissions:")) {
                console.error("👉 Run 'gas push -f' and 'gas creds --force' (check all permission boxes in browser) to grant the required scopes.");
            }
        }
        return { __gasException: gasException };
    }

    const parsed = parseClaspRunOutput(stdout);
    if (parsed) {
        return parsed;
    }

    if (proc.status === 0 && stdout) {
        return stdout;
    }

    if (verbose) {
        if (proc.status !== 0) {
            console.error(`❌ clasp run ${fnName} failed (exit code ${proc.status}):\n${combined || "(no output)"}`);
        } else {
            console.log(`ℹ️  Raw clasp output:\n${combined || "(empty response)"}`);
        }
    }

    return null;
}

function printRemoteRollback(res) {
    if (typeof res === "string") {
        console.log(`✅ Remote Rollback: ${res}`);
