function generateAppKey() {
    return "base64:" + crypto.randomBytes(32).toString("base64");
}

function readEnvAppKey(envPath) {
    if (!fs.existsSync(envPath)) return "";
    const content = fs.readFileSync(envPath, "utf8");
    const match = content.match(/^\s*APP_KEY\s*=\s*(.*)\s*$/m);
    if (!match) return "";
    return match[1].trim().replace(/^["']|["']$/g, "");
}

function upsertEnvKey(envPath, key, value) {
    let lines = fs.existsSync(envPath)
        ? fs.readFileSync(envPath, "utf8").split(/\r?\n/)
        : [];

    const pattern = new RegExp(`^\\s*${key}\\s*=`);
    let replaced = false;
    lines = lines.map((line) => {
        if (pattern.test(line)) {
            replaced = true;
            return `${key}="${value}"`;
        }
        return line;
    });

    if (!replaced) {
        if (lines.length && lines[lines.length - 1] !== "") {
            lines.push("");
        }
        lines.push(`${key}="${value}"`);
    }

    fs.writeFileSync(envPath, lines.join("\n").replace(/\n*$/, "\n"), "utf8");
}

function buildEnvPayload(appKey) {
    const localEnv = loadLocalEnv(path.join(ROOT_DIR, ".env"));
    if (appKey && !localEnv.APP_KEY) {
        return Object.assign({}, localEnv, { APP_KEY: appKey });
    }
    return localEnv;
}

async function ensureAppKeyOnFirstDeploy(cfg, remoteInfo = null) {
    const envPath = path.join(ROOT_DIR, ".env");
    const localEnv = loadLocalEnv(envPath);

    const existingKey =
        String(remoteInfo?.APP_KEY || "").trim() ||
        String(cfg.appKey || "").trim() ||
        String(localEnv.APP_KEY || "").trim() ||
        readEnvAppKey(envPath);

    // Sudah terdaftar: langsung lewati tanpa prompt maupun overwrite
    if (existingKey) {
        if (!cfg.appKey) {
            cfg.appKey = existingKey;
            writeClaspConfig(cfg);
        }
        if (!localEnv.APP_KEY && !readEnvAppKey(envPath)) {
            upsertEnvKey(envPath, "APP_KEY", existingKey);
        }
        return existingKey;
    }

    if (!process.stdin.isTTY || !process.stdout.isTTY) {
        return "";
    }

    console.log("\n🔐 APP_KEY is not registered yet (used for CSRF token encryption/signing).");
    const answer = await askQuestion("Generate a new APP_KEY and assign it to Script Properties now? [Y/n]: ");
    const normalized = answer.toLowerCase();

    if (normalized === "n" || normalized === "no") {
        console.log("⏭️  Skipped APP_KEY generation.");
        return "";
    }

    const newKey = generateAppKey();
    upsertEnvKey(envPath, "APP_KEY", newKey);
    cfg.appKey = newKey;
    writeClaspConfig(cfg);
    console.log("✅ Generated APP_KEY, saved to .env, and queued for Script Properties.");
    return newKey;
}

async function generateAppKeyCommand() {
    const hasClasp = fs.existsSync(CLASP_FILE);
    const cfg = hasClasp ? readClaspConfig() : {};
    const isForce = flags.includes("-f") || flags.includes("--force");
    const envPath = path.join(ROOT_DIR, ".env");
    const existing = String(cfg.appKey || "").trim() || readEnvAppKey(envPath);

    if (existing && !isForce) {
        console.log("ℹ️  APP_KEY is already configured. Pass --force to generate and overwrite with a new key.");
        return;
    }

    const newKey = generateAppKey();
    upsertEnvKey(envPath, "APP_KEY", newKey);

    if (hasClasp) {
        cfg.appKey = newKey;
        writeClaspConfig(cfg);
    }

    console.log(`✅ Generated APP_KEY: ${newKey}`);
    console.log("📄 Saved to .env" + (hasClasp ? " and .clasp.json." : "."));

    if (hasClasp) {
        const syncRes = tryClaspRun("setupWorkspace", {
            env: buildEnvPayload(newKey),
            migrate: false,
            seed: false,
            webAppUrl: cfg.webAppUrl || ""
        });
        if (syncRes && !syncRes.__gasException && syncRes.status) {
            console.log("☁️  Synced APP_KEY to GAS Script Properties.");
        } else {
            console.log("👉 Run 'gas push' or 'gas deploy' to sync APP_KEY to GAS Script Properties.");
        }
    }
}

async function pushAndSyncGas() {
    const cfg = readClaspConfig();
    const forceFlag = flags.includes("-f") || flags.includes("--force") ? " -f" : "";
    const shouldSeed = flags.includes("--seed");
    const showSetup = flags.includes("--setup");

    const appKey = await ensureAppKeyOnFirstDeploy(cfg, null);
    const envWithKey = buildEnvPayload(appKey);

    compileViews();
    runClaspCommand(`push${forceFlag}`);
    syncApiExecutableDeployment(cfg);

    const remoteRes = tryClaspRun("setupWorkspace", {
        env: envWithKey,
        migrate: true,
        seed: shouldSeed,
        webAppUrl: cfg.webAppUrl || ""
    });

    if (remoteRes && !remoteRes.__gasException && remoteRes.status) {
        printRemoteMigration(remoteRes.migration);
        if (shouldSeed) {
            printSeederSummary(remoteRes.seeder, "Remote Seeder");
        }
        if (remoteRes.first_setup || !remoteRes.SHEET_ID || showSetup) {
            printSetupSummary(remoteRes, cfg.webAppUrl);
        }
        cfg.initialized = true;
        writeClaspConfig(cfg);
        return;
    }

    if (!cfg.initialized || showSetup) {
        printManualSetupReminder(cfg.webAppUrl);
        cfg.initialized = true;
        writeClaspConfig(cfg);
    }
}

async function deployGasWebApp(description) {
    const cfg = readClaspConfig();
    const desc = (description || "Deploy via GAS CLI").replace(/"/g, "");
    const showSetup = flags.includes("--setup");
    const shouldMigrate = flags.includes("--migrate");
    const shouldSeed = flags.includes("--seed");

    if (shouldMigrate || shouldSeed) {
        const ready = await setupRemoteCredentials(cfg, false);
        if (!ready) process.exit(1);
    }

    const appKey = await ensureAppKeyOnFirstDeploy(cfg, null);
    const envWithKey = buildEnvPayload(appKey);

    console.log("📦 Pushing latest code to Google Apps Script...");
    compileViews();
    runClaspCommand("push -f");

    const existing = resolveWebAppDeployment(cfg);
    const deployCmd = existing
        ? `deploy -i ${existing.deploymentId} -d "${desc}"`
        : `deploy -d "${desc}"`;

    console.log(existing
        ? `🔄 Updating Web App deployment (${existing.deploymentId})...`
        : "🚀 Creating new Web App deployment...");

    let deploymentId = existing?.deploymentId || "";
    try {
        const out = execSync(`npx clasp ${deployCmd}`, { cwd: ROOT_DIR, encoding: "utf8" });
        process.stdout.write(out);

        const match = out.match(/(AKfycb[a-zA-Z0-9_-]+)/);
        if (match) deploymentId = match[1];
    } catch (err) {
        process.exit(err.status || 1);
    }

    if (!deploymentId) {
        console.error("❌ Failed to retrieve Deployment ID from clasp output.");
        process.exit(1);
    }

    const webAppUrl = `https://script.google.com/macros/s/${deploymentId}/exec`;
    cfg.deploymentId = deploymentId;
    cfg.webAppUrl = webAppUrl;
    writeClaspConfig(cfg);
    console.log(`🌐 Web App URL: ${webAppUrl}`);

    syncApiExecutableDeployment(cfg);

    const bootRes = tryClaspRun(
        "setupWorkspace",
        {
            webAppUrl,
            env: envWithKey,
            migrate: shouldMigrate,
            seed: shouldSeed
        },
        shouldMigrate || shouldSeed
    );

    if (bootRes && bootRes.__gasException) {
        process.exit(1);
    }

    if (bootRes && bootRes.status) {
        if (shouldMigrate) {
            printRemoteMigration(bootRes.migration);
        }
        if (shouldSeed) {
            printSeederSummary(bootRes.seeder, "Remote Seeder");
        }
        if (bootRes.first_setup || !bootRes.SHEET_ID || showSetup) {
            printSetupSummary(bootRes, webAppUrl);
        }
        cfg.initialized = true;
        writeClaspConfig(cfg);
        return;
    }

    if (!cfg.initialized || showSetup) {
        printManualSetupReminder(webAppUrl);
        cfg.initialized = true;
        writeClaspConfig(cfg);
    }
}

function writeSrcFile(relPath, content) {
